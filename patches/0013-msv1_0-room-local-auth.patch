+/* Virtual gives every room its own identity, so programs can use Windows
+ * authentication between their own processes (NegotiateStream, WCF, local HTTP)
+ * without a domain. Other targets keep using Samba's ntlm_auth. */
+static char *local_auth_helper(void)
+{
+    WCHAR path[MAX_PATH];
+    DWORD len = GetEnvironmentVariableW(L"VIRTUAL_LOCAL_AUTH_HELPER", path, ARRAY_SIZE(path));
+    char *ret;
+    int size;
+
+    if (!len || len >= ARRAY_SIZE(path) || !GetEnvironmentVariableW(L"VIRTUAL_LOCAL_AUTH_FILE", NULL, 0)) return NULL;
+    if (!(size = WideCharToMultiByte( CP_UNIXCP, 0, path, -1, NULL, 0, NULL, NULL ))) return NULL;
+    if (!(ret = malloc( size ))) return NULL;
+    WideCharToMultiByte( CP_UNIXCP, 0, path, -1, ret, size, NULL, NULL );
+    return ret;
+}
+
+static WCHAR *get_local_principal(void)
+{
+    WCHAR computer[MAX_COMPUTERNAME_LENGTH + 1], user[257], *name;
+    DWORD computer_len = ARRAY_SIZE(computer), user_len = ARRAY_SIZE(user);
+    if (!GetComputerNameW(computer, &computer_len) || !GetUserNameW(user, &user_len)) return NULL;
+    if (!(name = malloc((computer_len + user_len + 1) * sizeof(*name)))) return NULL;
+    wcscpy(name, computer);
+    wcscat(name, L"\\");
+    wcscat(name, user);
+    return name;
+}
+
+static BOOL is_local_host(const WCHAR *host, size_t len)
+{
+    static const WCHAR *names[] = { L"localhost", L"127.0.0.1", L"[::1]" };
+    WCHAR computer[MAX_COMPUTERNAME_LENGTH + 1];
+    DWORD size = ARRAY_SIZE(computer);
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(names); i++)
+        if (wcslen(names[i]) == len && !wcsnicmp(host, names[i], len)) return TRUE;
+    return GetComputerNameW(computer, &size) && size == len && !wcsnicmp(host, computer, len);
+}
+
+/* Service principal names such as host/localhost, HTTP/127.0.0.1:8080 or
+ * RestrictedKrbHost/COMPUTER point to this machine. */
+static BOOL is_local_target(const UNICODE_STRING *target)
+{
+    WCHAR text[288], *host, *end;
+
+    if (!target || !target->Buffer || target->Length % sizeof(WCHAR)
+            || target->Length >= sizeof(text)) return FALSE;
+    memcpy(text, target->Buffer, target->Length);
+    text[target->Length / sizeof(WCHAR)] = 0;
+    host = wcschr(text, '/') ? wcschr(text, '/') + 1 : text;
+    if (*host == '[')
+    {
+        if (!(end = wcschr(host, ']'))) return FALSE;
+        end++;
+    }
+    else end = host + wcscspn(host, L":/");
+    return is_local_host(host, end - host);
+}
+
+static char *get_room_principal_arg(void)
+{
+    WCHAR *principal = get_local_principal();
+    char *arg = NULL;
+    int len;
+
+    if (!principal) return NULL;
+    len = WideCharToMultiByte( CP_UTF8, 0, principal, -1, NULL, 0, NULL, NULL );
+    if (len && (arg = malloc( len + 17 )))
+    {
+        strcpy( arg, "--room-principal=" );
+        WideCharToMultiByte( CP_UTF8, 0, principal, -1, arg + 17, len, NULL, NULL );
+    }
+    free( principal );
+    return arg;
+}
+
+/* Map only a cryptographically authenticated, room-local principal to the
+ * existing Wine logon token. Never map a foreign/domain principal to this user. */
+static NTSTATUS set_local_principal(struct ntlm_ctx *ctx, const char *authenticated)
+{
+    WCHAR *expected, *provided = NULL;
+    int length;
+    if (!ctx->local_auth) return SEC_E_OK;
+    if (!(expected = get_local_principal())) return SEC_E_LOGON_DENIED;
+    if (authenticated)
+    {
+        length = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, authenticated, -1, NULL, 0);
+        if (!length || length > 288 || !(provided = malloc(length * sizeof(*provided))))
+        { free(expected); return SEC_E_LOGON_DENIED; }
+        MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, authenticated, -1, provided, length);
+        if (wcsicmp(expected, provided))
+        { free(provided); free(expected); return SEC_E_LOGON_DENIED; }
+        free(provided);
+    }
+    free(ctx->local_principal);
+    ctx->local_principal = expected;
+    return SEC_E_OK;
+}
+
+static NTSTATUS NTAPI ntlm_SpGetContextToken(LSA_SEC_HANDLE handle, HANDLE *token)
+{
+    struct ntlm_ctx *ctx = (struct ntlm_ctx *)handle;
+    WCHAR *expected;
+    HANDLE source;
+    BOOL matches, success;
+    if (!token) return SEC_E_INVALID_TOKEN;
+    *token = NULL;
+    if (!ctx || !ctx->authenticated) return SEC_E_INVALID_HANDLE;
+    if (!ctx->local_auth || !ctx->local_principal) return SEC_E_UNSUPPORTED_FUNCTION;
+    expected = get_local_principal();
+    matches = expected && !wcsicmp(expected, ctx->local_principal);
+    free(expected);
+    if (!matches) return SEC_E_LOGON_DENIED;
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_DUPLICATE | TOKEN_QUERY, &source)) return SEC_E_LOGON_DENIED;
+    success = DuplicateTokenEx(source, TOKEN_QUERY | TOKEN_DUPLICATE | TOKEN_IMPERSONATE, NULL,
+            SecurityImpersonation, TokenImpersonation, token);
+    CloseHandle(source);
+    return success ? SEC_E_OK : SEC_E_LOGON_DENIED;
+}
+
 static void ntlm_cleanup( struct ntlm_ctx *ctx )
 {
+    if (!ctx) return;
     WINE_UNIX_CALL( unix_cleanup, ctx );
+    free(ctx->local_principal);
+    SecureZeroMemory(ctx->session_key, sizeof(ctx->session_key));
 }
 
