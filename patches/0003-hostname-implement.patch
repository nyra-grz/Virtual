+static HRESULT WINAPI hostname_statics_iface_Compare( IHostNameStatics *iface, HSTRING value1, HSTRING value2, INT32 *result )
+{
+    HSTRING canonical1 = NULL, canonical2 = NULL, display = NULL;
+    HostNameType type1, type2;
+    HRESULT hr;
+
+    TRACE( "iface %p, value1 %s, value2 %s, result %p.\n", iface, debugstr_hstring(value1), debugstr_hstring(value2), result );
+
+    if (!result) return E_POINTER;
+    if (FAILED(hr = parse_hostname( value1, &type1, &canonical1, &display ))) return hr;
+    WindowsDeleteString( display );
+    if (FAILED(hr = parse_hostname( value2, &type2, &canonical2, &display )))
+    {
+        WindowsDeleteString( canonical1 );
+        return hr;
+    }
+    WindowsDeleteString( display );
+    if (type1 != type2) *result = type1 < type2 ? -1 : 1;
+    else *result = CompareStringOrdinal( WindowsGetStringRawBuffer( canonical1, NULL ), -1,
+                                         WindowsGetStringRawBuffer( canonical2, NULL ), -1, TRUE ) - CSTR_EQUAL;
+    WindowsDeleteString( canonical1 );
+    WindowsDeleteString( canonical2 );
+    return S_OK;
+}
