# Virtual: Windows memory behavior contracts.
diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -2017,6 +2017,23 @@
         if ((view->protect & access) != access) return STATUS_INVALID_PAGE_PROTECTION;
     }
 
+#ifdef __APPLE__
+    /* A read-only file view is MAP_SHARED on Darwin so file changes remain
+     * visible. mprotect cannot grant it private writes. Mach's COPY protection
+     * creates the required copy-on-write shadow without modifying the file or
+     * changing unrelated shared views. Do this before publishing page metadata. */
+    if ((vprot & VPROT_WRITECOPY) && (view->protect & SEC_FILE) && !(view->protect & SEC_IMAGE))
+    {
+        mach_vm_address_t addr = (mach_vm_address_t)ROUND_ADDR( base, host_page_mask );
+        mach_vm_size_t len = ROUND_SIZE( base, size, host_page_mask );
+        int prot = get_unix_prot( view->protect | VPROT_COMMITTED ) | PROT_WRITE;
+        /* Change the maximum, not the current protection. A guard or later
+         * protection transition must still be able to use the view's rights. */
+        if (mach_vm_protect( mach_task_self(), addr, len, TRUE, prot | VM_PROT_COPY ) != KERN_SUCCESS)
+            return STATUS_ACCESS_DENIED;
+    }
+#endif
+
     if (!set_vprot( view, base, size, vprot | VPROT_COMMITTED )) return STATUS_ACCESS_DENIED;
     return STATUS_SUCCESS;
 }
@@ -6226,6 +6243,8 @@
 NTSTATUS WINAPI NtLockVirtualMemory( HANDLE process, PVOID *addr, SIZE_T *size, ULONG unknown )
 {
     unsigned int status = STATUS_SUCCESS;
+    sigset_t sigset;
+    SIZE_T offset;
 
     if (process != NtCurrentProcess())
     {
@@ -6251,8 +6270,49 @@
     *size = ROUND_SIZE( *addr, *size, page_mask );
     *addr = ROUND_ADDR( *addr, page_mask );
 
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    /* mlock does not access a page through Wine's guard handling. Windows
+     * consumes the first guard and reports its violation without locking or
+     * dirtying the page; a retry can then succeed. */
+    if (!is_beyond_limit( *addr, *size, user_space_limit ))
+    {
+        for (offset = 0; offset < *size; offset += page_size)
+        {
+            char *page = (char *)*addr + offset;
+            BYTE vprot = get_page_vprot( page );
+            if (!(vprot & VPROT_COMMITTED)) { status = STATUS_NOT_COMMITTED; goto done; }
+            if (!(vprot & (VPROT_READ | VPROT_WRITE | VPROT_EXEC | VPROT_WRITECOPY)))
+            {
+                status = STATUS_ACCESS_VIOLATION;
+                goto done;
+            }
+            if (!(vprot & VPROT_GUARD)) continue;
+            set_page_vprot_bits( page, page_size, 0, VPROT_GUARD );
+            if (mprotect_range( page, page_size, 0, 0 ))
+            {
+                set_page_vprot_bits( page, page_size, VPROT_GUARD, 0 );
+                status = STATUS_ACCESS_DENIED;
+            }
+            else status = STATUS_GUARD_PAGE_VIOLATION;
+            goto done;
+        }
+    }
     if (mlock( ROUND_ADDR( *addr, host_page_mask ), ROUND_SIZE( *addr, *size, host_page_mask ) ))
         status = STATUS_ACCESS_DENIED;
+    else if (!use_kernel_writewatch && !is_beyond_limit( *addr, *size, user_space_limit ))
+    {
+        /* Windows probes writable pages while pinning them. Publish the same
+         * write-watch side effect without changing their payload. */
+        for (offset = 0; offset < *size; offset += page_size)
+        {
+            char *page = (char *)*addr + offset;
+            BYTE vprot = get_page_vprot( page );
+            if ((vprot & (VPROT_WRITE | VPROT_WRITEWATCH)) == (VPROT_WRITE | VPROT_WRITEWATCH))
+                update_write_watches( page, page_size, page_size );
+        }
+    }
+done:
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
     return status;
 }
 
