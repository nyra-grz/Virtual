 {
-    FIXME("%p %ld %p\n", hService, dwSecurityInformation, lpSecurityDescriptor);
-    return TRUE;
+    SECURITY_DESCRIPTOR_CONTROL control;
+    PSECURITY_DESCRIPTOR relative = descriptor;
+    DWORD revision, len = 0, err;
+
+    TRACE( "%p %#lx %p\n", service, type, descriptor );
+
+    if (!descriptor || !GetSecurityDescriptorControl( descriptor, &control, &revision ))
+        return set_error( ERROR_INVALID_PARAMETER );
+
+    /* the service manager takes a self-relative descriptor */
+    if (!(control & SE_SELF_RELATIVE))
+    {
+        MakeSelfRelativeSD( descriptor, NULL, &len );
+        if (!len || !(relative = malloc( len ))) return set_error( ERROR_OUTOFMEMORY );
+        if (!MakeSelfRelativeSD( descriptor, relative, &len ))
+        {
+            free( relative );
+            return FALSE;
+        }
+    }
+    else len = GetSecurityDescriptorLength( descriptor );
+
+    __TRY
+    {
+        err = svcctl_SetServiceObjectSecurity( service, type, relative, len );
+    }
+    __EXCEPT(rpc_filter)
+    {
+        err = map_exception_code( GetExceptionCode() );
+    }
+    __ENDTRY
+
+    if (relative != descriptor) free( relative );
+    return set_error( err );
 }
 
