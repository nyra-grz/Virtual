+/* Virtual: service object security, stored like Windows in Services\<name>\Security
+ * (value "Security", self-relative descriptor). Services without one get Windows'
+ * default service DACL. Updaters (e.g. Epic Games) grant users the right to start
+ * their service and check that grant afterwards. */
+static const WCHAR default_service_sddl[] =
+    L"O:SYG:SYD:(A;;CCLCSWRPWPDTLOCRRC;;;SY)(A;;CCDCLCSWRPWPDTLOCRSDRCWDWO;;;BA)"
+    L"(A;;CCLCSWLOCRRC;;;IU)(A;;CCLCSWLOCRRC;;;SU)";
+
+/* returns a LocalAlloc'ed self-relative descriptor */
+static DWORD load_service_security(struct service_entry *entry, PSECURITY_DESCRIPTOR *sd)
+{
+    DWORD size = 0, type, err;
+    HKEY key;
+
+    *sd = NULL;
+    if (!RegOpenKeyExW(entry->db->root_key, entry->name, 0, KEY_READ, &key))
+    {
+        if (!RegGetValueW(key, L"Security", L"Security", RRF_RT_REG_BINARY, &type, NULL, &size) && size &&
+            (*sd = LocalAlloc(LMEM_FIXED, size)) &&
+            (RegGetValueW(key, L"Security", L"Security", RRF_RT_REG_BINARY, &type, *sd, &size) ||
+             !IsValidSecurityDescriptor(*sd)))
+        {
+            LocalFree(*sd);
+            *sd = NULL;
+        }
+        RegCloseKey(key);
+    }
+    if (*sd) return ERROR_SUCCESS;
+    if (!ConvertStringSecurityDescriptorToSecurityDescriptorW(default_service_sddl, SDDL_REVISION_1, sd, NULL))
+    {
+        err = GetLastError();
+        return err ? err : ERROR_OUTOFMEMORY;
+    }
+    return ERROR_SUCCESS;
+}
+
+static DWORD access_for_security_info(SECURITY_INFORMATION info, BOOL write)
+{
+    DWORD access = 0;
+
+    if (info & SACL_SECURITY_INFORMATION) access |= ACCESS_SYSTEM_SECURITY;
+    if (write)
+    {
+        if (info & DACL_SECURITY_INFORMATION) access |= WRITE_DAC;
+        if (info & (OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION)) access |= WRITE_OWNER;
+    }
+    else if (info & (DACL_SECURITY_INFORMATION | OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION))
+        access |= READ_CONTROL;
+    return access;
+}
+
 DWORD __cdecl svcctl_QueryServiceObjectSecurity(
-    SC_RPC_HANDLE service,
+    SC_RPC_HANDLE handle,
     SECURITY_INFORMATION info,
     BYTE *descriptor,
     DWORD buf_size,
     DWORD *needed_size)
 {
-    WINE_FIXME("\n");
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    PSECURITY_DESCRIPTOR stored = NULL;
+    SECURITY_DESCRIPTOR part;
+    struct sc_service_handle *service;
+    BOOL present, defaulted;
+    PSID sid;
+    PACL acl;
+    DWORD err;
+
+    WINE_TRACE("(%p, %#lx, %p, %lu)\n", handle, info, descriptor, buf_size);
+
+    if ((err = validate_service_handle(handle, access_for_security_info(info, FALSE), &service)))
+        return err;
+
+    service_lock(service->service_entry);
+    err = load_service_security(service->service_entry, &stored);
+    service_unlock(service->service_entry);
+    if (err) return err;
+
+    /* only the requested parts, like Windows */
+    InitializeSecurityDescriptor(&part, SECURITY_DESCRIPTOR_REVISION);
+    if ((info & OWNER_SECURITY_INFORMATION) && GetSecurityDescriptorOwner(stored, &sid, &defaulted))
+        SetSecurityDescriptorOwner(&part, sid, defaulted);
+    if ((info & GROUP_SECURITY_INFORMATION) && GetSecurityDescriptorGroup(stored, &sid, &defaulted))
+        SetSecurityDescriptorGroup(&part, sid, defaulted);
+    if ((info & DACL_SECURITY_INFORMATION) && GetSecurityDescriptorDacl(stored, &present, &acl, &defaulted))
+        SetSecurityDescriptorDacl(&part, present, acl, defaulted);
+    if ((info & SACL_SECURITY_INFORMATION) && GetSecurityDescriptorSacl(stored, &present, &acl, &defaulted))
+        SetSecurityDescriptorSacl(&part, present, acl, defaulted);
+
+    *needed_size = buf_size;
+    if (MakeSelfRelativeSD(&part, descriptor, needed_size)) err = ERROR_SUCCESS;
+    else err = GetLastError();
+    LocalFree(stored);
+    return err;
 }
 
 DWORD __cdecl svcctl_SetServiceObjectSecurity(
-    SC_RPC_HANDLE service,
+    SC_RPC_HANDLE handle,
     SECURITY_INFORMATION info,
     BYTE *descriptor,
     DWORD buf_size)
 {
-    WINE_FIXME("\n");
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    PSECURITY_DESCRIPTOR stored = NULL, sd = descriptor;
+    SECURITY_DESCRIPTOR merged;
+    struct sc_service_handle *service;
+    BOOL present, defaulted;
+    PSID sid;
+    PACL acl;
+    BYTE *result = NULL;
+    DWORD err, size = 0;
+    HKEY key;
+
+    WINE_TRACE("(%p, %#lx, %p, %lu)\n", handle, info, descriptor, buf_size);
+
+    if (!descriptor || !buf_size || !IsValidSecurityDescriptor(sd)) return ERROR_INVALID_PARAMETER;
+    if ((err = validate_service_handle(handle, access_for_security_info(info, TRUE), &service)))
+        return err;
+
+    service_lock(service->service_entry);
+    if ((err = load_service_security(service->service_entry, &stored))) goto done;
+
+    /* start from the stored descriptor, replace the parts the caller passes */
+    InitializeSecurityDescriptor(&merged, SECURITY_DESCRIPTOR_REVISION);
+    if (GetSecurityDescriptorOwner((info & OWNER_SECURITY_INFORMATION) ? sd : stored, &sid, &defaulted))
+        SetSecurityDescriptorOwner(&merged, sid, defaulted);
+    if (GetSecurityDescriptorGroup((info & GROUP_SECURITY_INFORMATION) ? sd : stored, &sid, &defaulted))
+        SetSecurityDescriptorGroup(&merged, sid, defaulted);
+    if (GetSecurityDescriptorDacl((info & DACL_SECURITY_INFORMATION) ? sd : stored, &present, &acl, &defaulted))
+        SetSecurityDescriptorDacl(&merged, present, acl, defaulted);
+    if (GetSecurityDescriptorSacl((info & SACL_SECURITY_INFORMATION) ? sd : stored, &present, &acl, &defaulted))
+        SetSecurityDescriptorSacl(&merged, present, acl, defaulted);
+
+    MakeSelfRelativeSD(&merged, NULL, &size);
+    if (!size || !(result = malloc(size)) || !MakeSelfRelativeSD(&merged, result, &size))
+    {
+        err = result ? GetLastError() : ERROR_OUTOFMEMORY;
+        goto done;
+    }
+    if (!(err = RegCreateKeyExW(service->service_entry->db->root_key, service->service_entry->name, 0, NULL,
+                                REG_OPTION_NON_VOLATILE, KEY_SET_VALUE, NULL, &key, NULL)))
+    {
+        err = RegSetKeyValueW(key, L"Security", L"Security", REG_BINARY, result, size);
+        RegCloseKey(key);
+    }
+
+done:
+    service_unlock(service->service_entry);
+    LocalFree(stored);
+    free(result);
+    return err;
 }
 
