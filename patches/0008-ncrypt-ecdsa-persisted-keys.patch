+/* Persisted keys live in the registry as private key blobs, one subkey per key name,
+ * under HKCU (or HKLM for NCRYPT_MACHINE_KEY_FLAG). Unlike Windows they are not
+ * protected with DPAPI; access is limited by the prefix's file permissions. */
+static const WCHAR key_store_path[] = L"Software\\Wine\\NCrypt\\Keys\\";
+
+static const WCHAR *key_algorithm_name(enum algid algid)
+{
+    return algid == ECDSA_P256 ? BCRYPT_ECDSA_P256_ALGORITHM : BCRYPT_RSA_ALGORITHM;
+}
+
+static const WCHAR *key_private_blob(enum algid algid)
+{
+    return algid == ECDSA_P256 ? BCRYPT_ECCPRIVATE_BLOB : BCRYPT_RSAFULLPRIVATE_BLOB;
+}
+
+static BCRYPT_ALG_HANDLE key_alg_handle(enum algid algid)
+{
+    return algid == ECDSA_P256 ? BCRYPT_ECDSA_P256_ALG_HANDLE : BCRYPT_RSA_ALG_HANDLE;
+}
+
+static WCHAR *stored_key_path(const WCHAR *name)
+{
+    WCHAR *path, *p;
+
+    if (!(path = malloc((wcslen(key_store_path) + wcslen(name) + 1) * sizeof(WCHAR)))) return NULL;
+    wcscpy(path, key_store_path);
+    wcscat(path, name);
+    /* key names may contain backslashes, registry key names may not */
+    for (p = path + wcslen(key_store_path); *p; p++) if (*p == '\\') *p = '/';
+    return path;
+}
+
+static HKEY stored_key_root(DWORD flags)
+{
+    return (flags & NCRYPT_MACHINE_KEY_FLAG) ? HKEY_LOCAL_MACHINE : HKEY_CURRENT_USER;
+}
+
+static LSTATUS open_stored_key(const WCHAR *name, DWORD flags, BOOL create, HKEY *hkey)
+{
+    WCHAR *path;
+    LSTATUS ret;
+
+    if (!(path = stored_key_path(name))) return ERROR_OUTOFMEMORY;
+    if (create) ret = RegCreateKeyExW(stored_key_root(flags), path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, hkey, NULL);
+    else ret = RegOpenKeyExW(stored_key_root(flags), path, 0, KEY_READ, hkey);
+    free(path);
+    return ret;
+}
+
+static SECURITY_STATUS set_key_name(struct object *object, const WCHAR *name, DWORD flags)
+{
+    SECURITY_STATUS ret;
+
+    if (!(object->key.name = wcsdup(name))) return NTE_NO_MEMORY;
+    object->key.store_flags = flags & NCRYPT_MACHINE_KEY_FLAG;
+    if ((ret = set_object_property(object, NCRYPT_NAME_PROPERTY, (BYTE *)name, (wcslen(name) + 1) * sizeof(WCHAR))))
+        return ret;
+    return set_object_property(object, NCRYPT_UNIQUE_NAME_PROPERTY, (BYTE *)name, (wcslen(name) + 1) * sizeof(WCHAR));
+}
+
+static SECURITY_STATUS save_key(struct object *object)
+{
+    static const WCHAR *saved_properties[] = { NCRYPT_EXPORT_POLICY_PROPERTY, NCRYPT_KEY_USAGE_PROPERTY };
+    const WCHAR *algid = key_algorithm_name(object->key.algid);
+    struct object_property *prop;
+    SECURITY_STATUS ret;
+    NTSTATUS status;
+    UCHAR *blob;
+    ULONG size;
+    LSTATUS err;
+    unsigned int i;
+    HKEY hkey;
+
+    status = BCryptExportKey(object->key.bcrypt_key, NULL, key_private_blob(object->key.algid), NULL, 0, &size, 0);
+    if (status != STATUS_SUCCESS) return map_ntstatus(status);
+    if (!(blob = malloc(size))) return NTE_NO_MEMORY;
+    status = BCryptExportKey(object->key.bcrypt_key, NULL, key_private_blob(object->key.algid), blob, size, &size, 0);
+    if (status != STATUS_SUCCESS)
+    {
+        free(blob);
+        return map_ntstatus(status);
+    }
+
+    if ((err = open_stored_key(object->key.name, object->key.store_flags, TRUE, &hkey)))
+    {
+        SecureZeroMemory(blob, size);
+        free(blob);
+        return HRESULT_FROM_WIN32(err);
+    }
+
+    err = RegSetValueExW(hkey, L"Algorithm", 0, REG_SZ, (const BYTE *)algid, (wcslen(algid) + 1) * sizeof(WCHAR));
+    if (!err) err = RegSetValueExW(hkey, L"Key", 0, REG_BINARY, blob, size);
+    for (i = 0; !err && i < ARRAY_SIZE(saved_properties); i++)
+    {
+        if ((prop = get_object_property(object, saved_properties[i])) && prop->value_size == sizeof(DWORD))
+            err = RegSetValueExW(hkey, saved_properties[i], 0, REG_DWORD, prop->value, sizeof(DWORD));
+    }
+    ret = err ? HRESULT_FROM_WIN32(err) : ERROR_SUCCESS;
+
+    RegCloseKey(hkey);
+    SecureZeroMemory(blob, size);
+    free(blob);
+    return ret;
+}
+
+static void free_object(struct object *object)
+{
+    unsigned int i;
+
+    for (i = 0; i < object->num_properties; i++)
+    {
+        if (!wcscmp(object->properties[i].key, NCRYPT_PROVIDER_HANDLE_PROPERTY))
+            NCryptFreeObject(*(NCRYPT_HANDLE *)object->properties[i].value);
+
+        free(object->properties[i].key);
+        free(object->properties[i].value);
+    }
+    free(object->properties);
+    free(object);
+}
+
+/* for keys that fail before they are handed out, possibly without a bcrypt key */
+static void free_new_key(struct object *object)
+{
+    if (object->key.bcrypt_key) BCryptDestroyKey(object->key.bcrypt_key);
+    free(object->key.name);
+    free_object(object);
+}
