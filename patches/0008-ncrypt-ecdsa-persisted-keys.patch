+static void test_persisted_key(void)
+{
+    static const WCHAR name[] = L"Wine Test Persisted Key\\Sub";
+    static const WCHAR rsa_name[] = L"Wine Test Persisted RSA Key";
+    BYTE hash[32] = {1, 2, 3}, sig[64], pub1[512], pub2[512];
+    DWORD pub1_size, pub2_size, sig_size, size;
+    NCRYPT_KEY_HANDLE key, key2;
+    NCRYPT_PROV_HANDLE prov;
+    SECURITY_STATUS ret;
+    WCHAR buf[64];
+
+    ret = NCryptOpenStorageProvider(&prov, NULL, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+
+    /* leftovers of an interrupted run */
+    if (!NCryptOpenKey(prov, &key, name, 0, 0)) NCryptDeleteKey(key, 0);
+    if (!NCryptOpenKey(prov, &key, rsa_name, 0, 0)) NCryptDeleteKey(key, 0);
+
+    key = 0;
+    ret = NCryptOpenKey(prov, &key, name, 0, 0);
+    ok(ret == NTE_BAD_KEYSET, "got %#lx\n", ret);
+    ret = NCryptOpenKey(0, &key, name, 0, 0);
+    ok(ret == NTE_INVALID_HANDLE, "got %#lx\n", ret);
+
+    ret = NCryptCreatePersistedKey(prov, &key, BCRYPT_ECDSA_P256_ALGORITHM, name, 0, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    size = 0;
+    ret = NCryptGetProperty(key, NCRYPT_NAME_PROPERTY, (BYTE *)buf, sizeof(buf), &size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ok(size == sizeof(name) && !lstrcmpW(buf, name), "got %s\n", wine_dbgstr_w(buf));
+    ret = NCryptGetProperty(key, NCRYPT_ALGORITHM_GROUP_PROPERTY, (BYTE *)buf, sizeof(buf), &size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ok(!lstrcmpW(buf, BCRYPT_ECDSA_ALGORITHM), "got %s\n", wine_dbgstr_w(buf));
+
+    /* not stored before NCryptFinalizeKey */
+    ret = NCryptOpenKey(prov, &key2, name, 0, 0);
+    ok(ret == NTE_BAD_KEYSET, "got %#lx\n", ret);
+
+    ret = NCryptFinalizeKey(key, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptExportKey(key, 0, BCRYPT_ECCPUBLIC_BLOB, NULL, pub1, sizeof(pub1), &pub1_size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptSignHash(key, NULL, hash, sizeof(hash), sig, sizeof(sig), &sig_size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ok(sig_size == 64, "got %lu\n", sig_size);
+
+    ret = NCryptCreatePersistedKey(prov, &key2, BCRYPT_ECDSA_P256_ALGORITHM, name, 0, 0);
+    ok(ret == NTE_EXISTS, "got %#lx\n", ret);
+    NCryptFreeObject(key);
+
+    ret = NCryptOpenKey(prov, &key, name, 0, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptExportKey(key, 0, BCRYPT_ECCPUBLIC_BLOB, NULL, pub2, sizeof(pub2), &pub2_size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ok(pub2_size == pub1_size && !memcmp(pub1, pub2, pub1_size), "reopened key differs\n");
+    ret = NCryptVerifySignature(key, NULL, hash, sizeof(hash), sig, sig_size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptSignHash(key, NULL, hash, sizeof(hash), sig, sizeof(sig), &sig_size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptGetProperty(key, NCRYPT_LENGTH_PROPERTY, (BYTE *)&size, sizeof(size), &sig_size, 0);
+    ok(ret == ERROR_SUCCESS && size == 256, "got %#lx, %lu\n", ret, size);
+
+    /* NCRYPT_OVERWRITE_KEY_FLAG replaces the stored key */
+    ret = NCryptCreatePersistedKey(prov, &key2, BCRYPT_ECDSA_P256_ALGORITHM, name, 0, NCRYPT_OVERWRITE_KEY_FLAG);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptFinalizeKey(key2, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    NCryptFreeObject(key2);
+    NCryptFreeObject(key);
+    ret = NCryptOpenKey(prov, &key, name, 0, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptExportKey(key, 0, BCRYPT_ECCPUBLIC_BLOB, NULL, pub2, sizeof(pub2), &pub2_size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ok(memcmp(pub1, pub2, pub1_size), "key was not replaced\n");
+
+    ret = NCryptDeleteKey(key, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptOpenKey(prov, &key, name, 0, 0);
+    ok(ret == NTE_BAD_KEYSET, "got %#lx\n", ret);
+
+    ret = NCryptCreatePersistedKey(prov, &key, BCRYPT_RSA_ALGORITHM, rsa_name, 0, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptFinalizeKey(key, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptExportKey(key, 0, BCRYPT_RSAPUBLIC_BLOB, NULL, pub1, sizeof(pub1), &pub1_size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    NCryptFreeObject(key);
+    ret = NCryptOpenKey(prov, &key, rsa_name, 0, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptExportKey(key, 0, BCRYPT_RSAPUBLIC_BLOB, NULL, pub2, sizeof(pub2), &pub2_size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ok(pub2_size == pub1_size && !memcmp(pub1, pub2, pub1_size), "reopened RSA key differs\n");
+    ret = NCryptDeleteKey(key, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+
+    NCryptFreeObject(prov);
+}
