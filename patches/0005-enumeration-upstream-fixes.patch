From 080c2d662ea91a6f64862f1a344c8dca25d6a8f4 Mon Sep 17 00:00:00 2001
From: Vibhav Pant <vpant@codeweavers.com>
Date: Tue, 15 Sep 2026 20:03:58 +0530
Subject: [PATCH] windows.devices.enumeration: Fix potential memory leak in
 devpropcompkeys_append_names.

Wine-Bug: https://bugs.winehq.org/show_bug.cgi?id=60241

Signed-off-by: Vibhav Pant <vpant@codeweavers.com>
---
 dlls/windows.devices.enumeration/main.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/dlls/windows.devices.enumeration/main.c b/dlls/windows.devices.enumeration/main.c
index 441de3b37b0..c19a29b83f0 100644
--- a/dlls/windows.devices.enumeration/main.c
+++ b/dlls/windows.devices.enumeration/main.c
@@ -514,7 +514,11 @@ static HRESULT WINAPI devpropcompkeys_append_names( DEVPROPCOMPKEY **ret_keys, U
     *ret_keys = NULL;
     *ret_keys_len = 0;
 
-    if (FAILED(hr = IIterable_HSTRING_First( names_iterable, &names ))) return hr;
+    if (FAILED(hr = IIterable_HSTRING_First( names_iterable, &names )))
+    {
+        free( keys );
+        return hr;
+    }
     for (hr = IIterator_HSTRING_get_HasCurrent( names, &valid ); SUCCEEDED( hr ) && valid; hr = IIterator_HSTRING_MoveNext( names, &valid ))
     {
         DEVPROPCOMPKEY key = {0};
-- 
