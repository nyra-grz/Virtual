index 5c818038fe0..85c7332166d 100644
--- a/dlls/windows.devices.enumeration/aqs.c
+++ b/dlls/windows.devices.enumeration/aqs.c
@@ -34,7 +34,7 @@ WINE_DEFAULT_DEBUG_CHANNEL( aqs );
 
 static BOOL is_idchar( WCHAR chr )
 {
-    static const WCHAR legal[] = { 5, '#', '-', '.', '_', '{', '}' };
+    static const WCHAR legal[] = { '#', '-', '.', '_', '{', '}' };
     int i;
 
     if (iswdigit( chr ) || iswalpha( chr ) || (chr >= 125 && chr <= 255)) return TRUE;
