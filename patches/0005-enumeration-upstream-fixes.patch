From b581027b8629ca090907b5b5cb5473880f838c3f Mon Sep 17 00:00:00 2001
From: Vibhav Pant <vpant@codeweavers.com>
Date: Tue, 15 Sep 2026 20:02:23 +0530
Subject: [PATCH] windows.devices.enumeration: Fix potential NULL deref in
 debugstr_DEV_QUERY_RESULT_ACTION_DATA.

Wine-Bug: https://bugs.winehq.org/show_bug.cgi?id=60241

Signed-off-by: Vibhav Pant <vpant@codeweavers.com>
---
 dlls/windows.devices.enumeration/main.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/dlls/windows.devices.enumeration/main.c b/dlls/windows.devices.enumeration/main.c
index 1509313c015..441de3b37b0 100644
--- a/dlls/windows.devices.enumeration/main.c
+++ b/dlls/windows.devices.enumeration/main.c
@@ -292,8 +292,10 @@ static HRESULT WINAPI device_watcher_get_Status( IDeviceWatcher *iface, DeviceWa
 
 static const char *debugstr_DEV_QUERY_RESULT_ACTION_DATA( const DEV_QUERY_RESULT_ACTION_DATA *data )
 {
-    const DEV_OBJECT *obj = &data->Data.DeviceObject;
+    const DEV_OBJECT *obj;
+
     if (!data) return wine_dbg_sprintf( "(null)" );
+    obj = &data->Data.DeviceObject;
     if (data->Action == DevQueryResultStateChange)
         return wine_dbg_sprintf( "{%d {%d}}", data->Action, data->Data.State );
     return wine_dbg_sprintf( "{%d {{%d %s %lu %p}}}", data->Action, obj->ObjectType, debugstr_w( obj->pszObjectId ), obj->cPropertyCount, obj->pProperties );
-- 
