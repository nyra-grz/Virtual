Restore upstream Wine 11.0 macOS GSBASE transitions for the complete Windows TEB.

CrossOver FOSS mirrors only Self/TLS/PEB into Darwin TSD. Inline ClientId reads
return zero, while API reads return the correct ID; Qt 6 mixes those paths and
crashes in platform initialization. LastError, stack bounds and fiber pointers
are affected too. Restore upstream switches at syscall/Unix/callback/signal
boundaries, leaving CrossOver's other signal and Rosetta fixes intact.

Adapted from LGPL-2.1-or-later Wine 11.0:
https://github.com/wine-mirror/wine/blob/wine-11.0/dlls/ntdll/unix/signal_x86_64.c
Regression: winrt/tests/teb.c (x86/x64); real Qt apps, full core gate.

diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -63,6 +63,9 @@
 #endif
 #ifdef __APPLE__
 # include <mach/mach.h>
+/* Match upstream Wine's Windows/Unix GSBASE transitions. Mirroring selected
+ * fields in Darwin TSD misses inline ClientId, LastError and fiber accesses. */
+extern void _thread_set_tsd_base(uint64_t);
 #endif
 
 #include "ntstatus.h"
@@ -526,7 +529,7 @@
 static unsigned int xstate_size = sizeof(XSAVE_AREA_HEADER);
 static UINT64 xstate_extended_features;
 
-#ifdef __linux__
+#if defined(__linux__) || defined(__APPLE__)
 static inline TEB *get_current_teb(void)
 {
     unsigned long rsp;
@@ -916,6 +919,10 @@
         arch_prctl( ARCH_SET_FS, ((struct amd64_thread_data *)thread_data->cpu_data)->pthread_teb );
     }
 #elif defined __APPLE__
+    {
+        struct ntdll_thread_data *thread_data = (struct ntdll_thread_data *)&get_current_teb()->GdiTebBatch;
+        _thread_set_tsd_base( (uint64_t)((struct amd64_thread_data *)thread_data->cpu_data)->pthread_teb );
+    }
     /* When in a syscall, CS will be the kernel's selector (0x07, SYSCALL_CS in xnu source)
      * instead of the user selector (cs64_sel: 0x2b, USER64_CS).
      * Fix up sigcontext so later code can compare it to cs64_sel.
@@ -939,6 +946,10 @@
         !is_inside_signal_stack( (void *)RSP_sig(sigcontext )) &&
         !is_inside_syscall( RSP_sig(sigcontext) ))
         __asm__ volatile( "movw %0,%%fs" :: "r" (fs32_sel) );
+#elif defined __APPLE__
+    if (!is_inside_signal_stack( (void *)RSP_sig(sigcontext)) &&
+        !is_inside_syscall( RSP_sig(sigcontext)))
+        _thread_set_tsd_base( (uint64_t)NtCurrentTeb() );
 #endif
     if (is_16bit( sigcontext )) return;
 #ifdef DS_sig
@@ -1818,6 +1829,13 @@
                    "jz 1f\n\t"
                    "movw %ax,%fs\n"
                    "1:\n\t"
+#elif defined __APPLE__
+                   "movq %rcx,%r10\n\t"
+                   "movq %r13,%rdi\n\t"
+                   "xorl %esi,%esi\n\t"
+                   "movl $0x3000003,%eax\n\t"  /* _thread_set_tsd_base */
+                   "syscall\n\t"
+                   "movq %r10,%rcx\n\t"
 #endif
                    "movq 0x330(%r13),%r10\n\t" /* amd64_thread_data()->instrumentation_callback */
                    "movq (%r10),%r10\n\t"
@@ -3295,6 +3313,12 @@
                    "syscall\n\t"
                    "leaq -0x98(%rbp),%rcx\n"
                    "2:\n\t"
+#elif defined __APPLE__
+                   "movq 0x320(%r13),%rdi\n\t"     /* pthread_teb */
+                   "xorl %esi,%esi\n\t"
+                   "movl $0x3000003,%eax\n\t"
+                   "syscall\n\t"
+                   "leaq -0x98(%rbp),%rcx\n"
 #endif
                    "ldmxcsr 0x33c(%r13)\n\t"       /* amd64_thread_data()->mxcsr */
                    "movl 0xb0(%rcx),%eax\n\t"      /* frame->syscall_id */
@@ -3341,6 +3365,15 @@
                    "jz 1f\n\t"
                    "movw %dx,%fs\n"
                    "1:\n\t"
+#elif defined __APPLE__
+                   "movq %rax,%r8\n\t"
+                   "movq %rcx,%rdx\n\t"
+                   "movq %r13,%rdi\n\t"            /* teb */
+                   "xorl %esi,%esi\n\t"
+                   "movl $0x3000003,%eax\n\t"
+                   "syscall\n\t"
+                   "movq %rdx,%rcx\n\t"
+                   "movq %r8,%rax\n\t"
 #endif
                    "movl 0xb4(%rcx),%edx\n\t"      /* frame->restore_flags */
                    "testl $0x48,%edx\n\t"          /* CONTEXT_FLOATING_POINT | CONTEXT_XSTATE */
@@ -3583,6 +3616,11 @@
                    "mov $158,%eax\n\t"             /* SYS_arch_prctl */
                    "syscall\n\t"
                    "2:\n\t"
+#elif defined __APPLE__
+                   "movq 0x320(%r13),%rdi\n\t"     /* pthread_teb */
+                   "xorl %esi,%esi\n\t"
+                   "movl $0x3000003,%eax\n\t"
+                   "syscall\n\t"
