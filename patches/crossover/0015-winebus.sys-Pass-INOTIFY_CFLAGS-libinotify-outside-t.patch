From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Timur <daniel.timur.23gmail.com>
Date: Sun, 25 Oct 2026 09:22:51 +0100
Subject: [PATCH] winebus.sys: Pass INOTIFY_CFLAGS (libinotify outside the
 system include path)

---
 dlls/winebus.sys/Makefile.in | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dlls/winebus.sys/Makefile.in b/dlls/winebus.sys/Makefile.in
index 652aae82..de1e18a1 100644
--- a/dlls/winebus.sys/Makefile.in
+++ b/dlls/winebus.sys/Makefile.in
@@ -2,7 +2,7 @@ MODULE    = winebus.sys
 UNIXLIB   = winebus.so
 IMPORTS   = ntoskrnl hidparse
 UNIX_LIBS    = $(IOKIT_LIBS) $(UDEV_LIBS) $(PTHREAD_LIBS) $(INOTIFY_LIBS)
-UNIX_CFLAGS  = $(UDEV_CFLAGS) $(SDL2_CFLAGS)
+UNIX_CFLAGS  = $(UDEV_CFLAGS) $(SDL2_CFLAGS) $(INOTIFY_CFLAGS)
 
 EXTRADLLFLAGS = -Wl,--subsystem,native
 
