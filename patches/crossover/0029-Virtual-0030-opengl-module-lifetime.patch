Balance GDI forwarding references and resolve entrypoints under a live reference. Clear released thread-local pixel-format cache fields, allowing safe unload/reload and replacement of the renderer.

diff --git a/dlls/gdi32/opengl.c b/dlls/gdi32/opengl.c
--- a/dlls/gdi32/opengl.c
+++ b/dlls/gdi32/opengl.c
@@ -32,79 +32,87 @@
 #include "winnt.h"
 
 
-static HMODULE opengl32;
-static INT (WINAPI *wglChoosePixelFormat)(HDC,const PIXELFORMATDESCRIPTOR *);
-static INT (WINAPI *wglDescribePixelFormat)(HDC,INT,UINT,PIXELFORMATDESCRIPTOR*);
-static INT (WINAPI *wglGetPixelFormat)(HDC);
-static BOOL (WINAPI *wglSetPixelFormat)(HDC,INT,const PIXELFORMATDESCRIPTOR*);
-static BOOL (WINAPI *wglSwapBuffers)(HDC);
+/* GDI must not keep an implicit process-lifetime reference to opengl32.
+ * Applications can unload the driver after a probe and load another renderer.
+ * Resolve while holding a temporary reference; cached entrypoints become stale
+ * when the application unloads/replaces that module. Preserve the call's error. */
 
-/******************************************************************************
- *		ChoosePixelFormat (GDI32.@)
- */
 INT WINAPI ChoosePixelFormat( HDC hdc, const PIXELFORMATDESCRIPTOR *pfd )
 {
-    if (!wglChoosePixelFormat)
-    {
-        if (!opengl32) opengl32 = LoadLibraryW( L"opengl32.dll" );
-        if (!(wglChoosePixelFormat = (void *)GetProcAddress( opengl32, "wglChoosePixelFormat" )))
-            return 0;
-    }
-    return wglChoosePixelFormat( hdc, pfd );
+    HMODULE module = LoadLibraryW( L"opengl32.dll" );
+    INT (WINAPI *func)(HDC hdc, const PIXELFORMATDESCRIPTOR *pfd);
+    INT result = 0;
+    DWORD error;
+
+    if (!module) return 0;
+    if ((func = (void *)GetProcAddress( module, "wglChoosePixelFormat" )))
+        result = func( hdc, pfd );
+    error = GetLastError();
+    FreeLibrary( module );
+    SetLastError( error );
+    return result;
 }
 
