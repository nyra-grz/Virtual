Use the normal macOS window plane for ordinary Windows windows.

WS_EX_TOPMOST remains a Windows ordering property, not a mandate to outrank
other Mac applications or the Dock. Borderless/full-screen geometry alone no
longer raises the plane. Explicit kiosk overlays and actual display capture
retain their required planes. A shared native policy is compiled into both
window-level calculation and floating-floor adjustment; tests compile that
exact header against AppKit constants without controlling the user's desktop.

Overlay is opt-in; false environment values do not accidentally enable it.
No application names, executable checks or application-specific configuration.

--- /dev/null
+++ b/dlls/winemac.drv/virtual_window_levels.h
@@ -0,0 +1,35 @@
+/*
+ * Shared macOS window-plane policy for Virtual's Wine driver.
+ * Copyright 2026 Virtual contributors
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#ifndef VIRTUAL_WINDOW_LEVELS_H
+#define VIRTUAL_WINDOW_LEVELS_H
+
+#include <string.h>
+#include <strings.h>
+
+static inline BOOL virtual_overlay_value(const char *value)
+{
+    return value && (!strcmp(value, "1") || !strcasecmp(value, "true")
+            || !strcasecmp(value, "yes") || !strcasecmp(value, "on"));
+}
+
+static inline NSInteger virtual_window_level(BOOL active, BOOL floating,
+        BOOL captured, BOOL overlay, BOOL demoted)
+{
+    if (demoted) return NSNormalWindowLevel;
+    if (active && captured) return CGShieldingWindowLevel() + 1 + !!floating;
+    if (overlay)
+        return (active ? NSStatusWindowLevel + 1 : NSFloatingWindowLevel) + !!floating;
+    return NSNormalWindowLevel;
+}
+
+static inline NSInteger virtual_floating_level(NSInteger level, BOOL floating,
+        BOOL demoted, NSInteger nonfloating_level)
+{
+    if (!floating || demoted || level <= NSNormalWindowLevel) return level;
+    return level > nonfloating_level ? level : nonfloating_level + 1;
+}
+
+#endif
