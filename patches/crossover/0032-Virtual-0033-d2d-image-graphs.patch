+/* Resolve alias graphs without losing image DPI, clips or the caller's world
+ * transform. Keep every traversed image alive: PrepareForRender may replace an
+ * input, and a released object's address must not be mistaken for a cycle. */
+HRESULT d2d_effect_resolve_bitmap(struct d2d_device_context *context, ID2D1Image *image,
+        BOOL prepare, ID2D1Bitmap **bitmap)
+{
+    ID2D1Image **visited = NULL, *current = image, *next;
+    size_t count = 0, capacity = 0, i;
+    struct d2d_effect *effect;
+    D2D1_CHANGE_TYPE changes;
+    HRESULT hr = E_NOTIMPL;
+
+    *bitmap = NULL;
+    if (!image) return D2DERR_INVALID_GRAPH_CONFIGURATION;
+    /* Keep the ordinary bitmap path allocation-free. */
+    if (SUCCEEDED(ID2D1Image_QueryInterface(image, &IID_ID2D1Bitmap, (void **)bitmap)))
+        return S_OK;
+    if (context->cs) EnterCriticalSection(context->cs);
+    while (current)
+    {
+        for (i = 0; i < count; ++i)
+            if (visited[i] == current) { hr = D2DERR_CYCLIC_GRAPH; goto done; }
+        if (!d2d_array_reserve((void **)&visited, &capacity, count + 1, sizeof(*visited)))
+        {
+            hr = E_OUTOFMEMORY;
+            goto done;
+        }
+        ID2D1Image_AddRef(current);
+        visited[count++] = current;
+        if (SUCCEEDED(ID2D1Image_QueryInterface(current, &IID_ID2D1Bitmap, (void **)bitmap)))
+        {
+            hr = S_OK;
+            goto done;
+        }
+        if (current->lpVtbl != &d2d_effect_image_vtbl)
+        {
+            hr = E_NOTIMPL;
+            goto done;
+        }
+        effect = impl_from_ID2D1Image(current);
+        if (effect->preparing)
+        {
+            hr = D2DERR_CYCLIC_GRAPH;
+            goto done;
+        }
+        if (effect->effect_context->device_context->device != context->device)
+        {
+            hr = D2DERR_WRONG_RESOURCE_DOMAIN;
+            goto done;
+        }
+        if (prepare)
+        {
+            changes = effect->changes;
+            if (effect->last_context != context || effect->last_dpi_x != context->desc.dpiX
+                    || effect->last_dpi_y != context->desc.dpiY
+                    || memcmp(&effect->last_drawing_state, &context->drawing_state,
+                            sizeof(effect->last_drawing_state)))
+                changes |= D2D1_CHANGE_TYPE_CONTEXT;
+            if (changes)
+            {
+                effect->changes = D2D1_CHANGE_TYPE_NONE;
+                effect->preparing = TRUE;
+                hr = ID2D1EffectImpl_PrepareForRender(effect->impl, changes);
+                effect->preparing = FALSE;
+                if (FAILED(hr))
+                {
+                    effect->changes |= changes;
+                    goto done;
+                }
+                ID2D1DeviceContext6_AddRef(&context->ID2D1DeviceContext6_iface);
+                if (effect->last_context)
+                    ID2D1DeviceContext6_Release(&effect->last_context->ID2D1DeviceContext6_iface);
+                effect->last_context = context;
+                effect->last_dpi_x = context->desc.dpiX;
+                effect->last_dpi_y = context->desc.dpiY;
+                effect->last_drawing_state = context->drawing_state;
+            }
+        }
+        if (!effect->graph || !effect->graph->passthrough)
+        {
+            hr = E_NOTIMPL;
+            goto done;
+        }
+        if (effect->graph->passthrough_input >= effect->input_count
+                || !(next = effect->inputs[effect->graph->passthrough_input]))
+        {
+            hr = D2DERR_INVALID_GRAPH_CONFIGURATION;
+            goto done;
+        }
+        current = next;
+    }
+    hr = D2DERR_INVALID_GRAPH_CONFIGURATION;
+done:
+    for (i = 0; i < count; ++i) ID2D1Image_Release(visited[i]);
+    free(visited);
+    if (context->cs) LeaveCriticalSection(context->cs);
+    return hr;
+}
