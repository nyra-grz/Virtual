 };
 static struct dxgi_main dxgi_main;
+
+HRESULT WINAPI DXGIDeclareAdapterRemovalSupport(void)
+{
+    HRESULT hr;
+
+    wined3d_mutex_lock();
+    if (dxgi_main.removal_support_declared)
+        hr = DXGI_ERROR_ALREADY_EXISTS;
+    else if (dxgi_main.device_created)
+        hr = DXGI_ERROR_INVALID_CALL;
+    else
+    {
+        /* Wine reports device loss to the application, rather than terminating
+         * the process. Keep that behavior and record the once-only opt-in. */
+        dxgi_main.removal_support_declared = TRUE;
+        hr = S_OK;
+    }
+    wined3d_mutex_unlock();
+    return hr;
+}
+
+/* Called under the wined3d mutex when a DXGI device has been created. */
+void dxgi_record_device_creation(void)
+{
+    dxgi_main.device_created = TRUE;
+}
 
 static void dxgi_main_cleanup(void)
 {
