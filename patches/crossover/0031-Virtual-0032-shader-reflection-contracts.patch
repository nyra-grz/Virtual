 static HRESULT STDMETHODCALLTYPE d3dcompiler_shader_reflection_GetMinFeatureLevel(
         ID3D11ShaderReflection *iface, D3D_FEATURE_LEVEL *level)
 {
-    FIXME("iface %p, level %p stub!\n", iface, level);
-
-    return E_NOTIMPL;
+    struct d3dcompiler_shader_reflection *reflection = impl_from_ID3D11ShaderReflection(iface);
+    unsigned int major = (reflection->version >> 4) & 0xf;
+    unsigned int minor = reflection->version & 0xf;
+
+    TRACE("iface %p, level %p.\n", iface, level);
+
+    if (!level) return E_INVALIDARG;
+    if (reflection->legacy_feature_level)
+        *level = reflection->legacy_feature_level;
+    else if (major == 4 && minor <= 1)
+        *level = minor ? D3D_FEATURE_LEVEL_10_1 : D3D_FEATURE_LEVEL_10_0;
+    else if (major == 5 && minor <= 1)
+        *level = D3D_FEATURE_LEVEL_11_0;
+    else
+        return E_FAIL;
+    return S_OK;
 }
 
