@@ -1970,6 +1970,40 @@ - (void) setupObservations
         NSNotificationCenter* wsnc = [[NSWorkspace sharedWorkspace] notificationCenter];
         NSDistributedNotificationCenter* dnc = [NSDistributedNotificationCenter defaultCenter];
 
+        if (virtual_kiosk_overlay())
+        {
+            /* Virtual's shortcut: shrink kiosk windows to normal windows or restore them. */
+            [dnc addObserverForName:@"com.oezdek.virtual.kiosk"
+                             object:nil
+                              queue:[NSOperationQueue mainQueue]
+                         usingBlock:^(NSNotification *note){
+                BOOL shrunk = [note.userInfo[@"shrunk"] boolValue];
+                virtual_kiosk_shrunk = shrunk;
+                for (NSWindow* window in [NSApp windows])
+                    if ([window isKindOfClass:[WineWindow class]])
+                        [(WineWindow*)window virtualSetKioskShrunk:shrunk];
+                [self adjustWindowLevels];
+                /* The program answers the size change asynchronously; settle levels afterwards. */
+                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 500 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+                    [self adjustWindowLevels];
+                });
+            }];
+        }
+
+        /* A program of this prefix switched the input desktop (SwitchDesktop). */
