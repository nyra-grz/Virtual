+/* Virtual: a kiosk window (borderless, covering the screen) behaves like an overlay above
+ * normal Mac apps instead of a locked-down full-screen mode, and the user can shrink it to
+ * a normal window with Virtual's shortcut. Set by Virtual for the programs it starts. */
+BOOL virtual_kiosk_overlay(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) enabled = getenv("VIRTUAL_KIOSK_OVERLAY") != NULL;
+    return enabled;
+}
+
+/* Virtual: the input desktop of this prefix, and whether the user shrank the kiosk. */
+static NSString* virtual_input_desktop;
+BOOL virtual_kiosk_shrunk;
+
+void virtual_set_input_desktop(NSString* name)
+{
+    if (!name.length || [name isEqualToString:virtual_input_desktop]) return;
+    [virtual_input_desktop release];
+    virtual_input_desktop = [name copy];
+}
+
+/* A program switched to a desktop of its own (kiosk and exam software does that). */
+static BOOL virtual_kiosk_desktop_active(void)
+{
+    return virtual_input_desktop && [virtual_input_desktop caseInsensitiveCompare:@"Default"] != NSOrderedSame;
+}
+
 static inline BOOL stage_manager_enabled(void)
 {
     /* There is no documented way to determine if Stage Manager is enabled,
@@ -1099,6 +1126,7 @@ - (void) dealloc
     {
         [[[NSWorkspace sharedWorkspace] notificationCenter] removeObserver:self];
         [[NSNotificationCenter defaultCenter] removeObserver:self];
+        [virtualDesktop release];
         [queue release];
         [latentChildWindows release];
         [latentParentWindow release];
@@ -1269,9 +1297,95 @@ - (NSInteger) minimumLevelForActive:(BOOL)active
             }
         }
 
+        /* Stays above other apps' windows while another app is active, until shrunk. */
+        if ([self virtualKioskDemoted])
+            level = NSNormalWindowLevel;
+        else if ((fullscreen && virtual_kiosk_overlay()) || [self virtualIsKiosk])
+        {
+            if (!active && level < NSFloatingWindowLevel)
+                level = NSFloatingWindowLevel + (self.floating ? 1 : 0);
+        }
+
         return level;
     }
 
+    /* On the desktop a program switched to for itself, i.e. part of a kiosk. */
+    - (BOOL) virtualIsKiosk
+    {
+        return virtual_kiosk_overlay() && virtualDesktop && virtual_kiosk_desktop_active() &&
+               [virtualDesktop caseInsensitiveCompare:virtual_input_desktop] == NSOrderedSame;
+    }
+
+    - (BOOL) virtualKioskDemoted
+    {
+        return virtual_kiosk_shrunk && (fullscreen || virtualKioskShrunk || [self virtualIsKiosk]);
+    }
+
+    - (void) virtualSetDesktop:(NSString*)name
+    {
+        [virtualDesktop release];
+        virtualDesktop = [name copy];
+        [self virtualUpdateDesktop];
+    }
+
+    - (void) virtualUpdateDesktop
+    {
+        BOOL hide = virtualDesktop && virtual_input_desktop &&
+                    [virtualDesktop caseInsensitiveCompare:virtual_input_desktop] != NSOrderedSame;
+
+        if (hide && !virtualDesktopHidden)
+        {
+            virtualDesktopHidden = YES;
+            virtualDesktopWasVisible = [self isVisible];
+            if (virtualDesktopWasVisible) [super orderWindow:NSWindowOut relativeTo:0];
+        }
+        else if (!hide && virtualDesktopHidden)
+        {
+            virtualDesktopHidden = NO;
+            if (virtualDesktopWasVisible) [super orderWindow:NSWindowAbove relativeTo:0];
+            virtualDesktopWasVisible = NO;
+        }
+    }
+
+    /* Wine may order the window in while its desktop is not the input desktop. */
+    - (void) orderWindow:(NSWindowOrderingMode)mode relativeTo:(NSInteger)otherWindowNumber
+    {
+        if (virtualDesktopHidden && mode != NSWindowOut)
+        {
+            virtualDesktopWasVisible = YES;
+            return;
+        }
+        if (virtualDesktopHidden) virtualDesktopWasVisible = NO;
+        [super orderWindow:mode relativeTo:otherWindowNumber];
+    }
+
+    - (void) virtualSetKioskShrunk:(BOOL)shrunk
+    {
+        NSScreen* screen;
+        NSRect frame;
+
+        if (shrunk == virtualKioskShrunk) return;
+        if (shrunk)
+        {
+            if (![self isVisible] || [self isMiniaturized]) return;
+            screen = [self screen] ? [self screen] : [NSScreen mainScreen];
+            if (!fullscreen && !([self virtualIsKiosk] && self.frame.size.width * self.frame.size.height >=
+                                 0.8 * screen.frame.size.width * screen.frame.size.height))
+                return;
+            virtualKioskFrame = self.wine_fractionalFrame;
+            frame = [screen visibleFrame];
+            frame = NSInsetRect(frame, frame.size.width * 0.15, frame.size.height * 0.15);
+        }
+        else
+            frame = virtualKioskFrame;
+
+        virtualKioskShrunk = shrunk;
+        [self setFrameAndWineFrame:frame];
+        [self updateFullscreen];
+        /* The program re-lays itself out for the new size, as after a WM_SIZE on Windows. */
+        [self postWindowFrameChanged:frame fullscreen:NO resizing:NO skipSizeMove:YES];
+    }
+
     - (void) postDidUnminimizeEvent
     {
         macdrv_event* event;
@@ -3565,6 +3679,44 @@ void macdrv_set_cocoa_window_title(macdrv_window w, const unsigned short* title,
 }
 }
 
+/***********************************************************************
+ *              macdrv_set_cocoa_window_desktop
+ */
+void macdrv_set_cocoa_window_desktop(macdrv_window w, const UniChar* desktop, size_t length,
+                                     const UniChar* input, size_t input_length)
+{
+@autoreleasepool
+{
+    WineWindow* window = (WineWindow*)w;
+    NSString* name = [NSString stringWithCharacters:desktop length:length];
+    NSString* inputName = [NSString stringWithCharacters:input length:input_length];
+
+    OnMainThreadAsync(^{
+        virtual_set_input_desktop(inputName);
+        [window virtualSetDesktop:name];
+    });
+}
+}
+
+/***********************************************************************
+ *              macdrv_switch_desktop
+ *
+ * Tells all Wine processes of this prefix (and this one) the new input desktop.
+ */
+void macdrv_switch_desktop(const UniChar* name, size_t length)
+{
+@autoreleasepool
+{
+    const char* prefix = getenv("WINEPREFIX");
+    NSDictionary* info = @{@"desktop": [NSString stringWithCharacters:name length:length],
+                           @"prefix": prefix ? @(prefix) : @""};
+    [[NSDistributedNotificationCenter defaultCenter] postNotificationName:@"com.oezdek.virtual.desktop"
+                                                                   object:nil
+                                                                 userInfo:info
+                                                       deliverImmediately:YES];
+}
+}
