+/**********************************************************************
+ *              SwitchDesktop   (MACDRV.@)
+ *
+ * Only windows of the input desktop are visible on Windows; tell every
+ * process of this prefix which desktop that is now.
+ */
+void macdrv_SwitchDesktop(const WCHAR *name)
+{
+    TRACE("%s\n", debugstr_w(name));
+    macdrv_switch_desktop(name, wcslen(name));
+}
+
+/* Which desktop a window belongs to and which one is visible right now. */
+static void set_cocoa_window_desktop(struct macdrv_win_data *data)
+{
+    WCHAR name[MAX_PATH], input[MAX_PATH];
+    HDESK desktop = NtUserGetThreadDesktop(GetCurrentThreadId()), input_desktop;
+
+    if (!NtUserGetObjectInformation(desktop, UOI_NAME, name, sizeof(name), NULL)) return;
+    input[0] = 0;
+    if ((input_desktop = NtUserOpenInputDesktop(0, FALSE, DESKTOP_READOBJECTS)))
+    {
+        if (!NtUserGetObjectInformation(input_desktop, UOI_NAME, input, sizeof(input), NULL)) input[0] = 0;
+        NtUserCloseDesktop(input_desktop);
+    }
+    macdrv_set_cocoa_window_desktop(data->cocoa_window, name, wcslen(name), input, wcslen(input));
+}
+
