+/* Device interfaces of network adapters (GUID_DEVINTERFACE_NET). */
+static const WCHAR device_selector[] =
+    L"System.Devices.InterfaceClassGuid:=\"{CAC88484-7515-4C03-82E6-71A87ABAC361}\" AND "
+    L"System.Devices.InterfaceEnabled:=System.StructuredQueryType.Boolean#True";
+
+/* Like Windows, Windows.Devices.WiFi sits on top of wlanapi.dll. */
+static HRESULT query_wifi( BOOL scan, struct wifi_info_params **out )
+{
+    static wine_wlan_query_func query;
+    struct wifi_info_params *params;
+    HMODULE wlanapi;
+    DWORD err;
+
+    *out = NULL;
+    if (!query && (wlanapi = LoadLibraryW( L"wlanapi.dll" )))
+        query = (wine_wlan_query_func)GetProcAddress( wlanapi, "__wine_wlan_query" );
+    if (!(params = calloc( 1, sizeof(*params) ))) return E_OUTOFMEMORY;
+    if (!query) WARN( "wlanapi has no Wi-Fi data, reporting no adapter.\n" );
+    else if ((err = query( params, scan ))) WARN( "Wi-Fi query failed, error %lu.\n", err );
+    *out = params;
+    return S_OK;
+}
+
+static void adapter_id( const struct wifi_info_params *info, WCHAR *buffer, size_t size )
+{
+    swprintf( buffer, size, L"\\\\?\\VIRTUAL#WIFI#%02X%02X%02X%02X%02X%02X#{cac88484-7515-4c03-82e6-71a87abac361}",
+              info->mac[0], info->mac[1], info->mac[2], info->mac[3], info->mac[4], info->mac[5] );
+}
+
+/* WiFiConnectionResult */
+
+struct connection_result
+{
+    IWiFiConnectionResult iface;
+    LONG ref;
+    WiFiConnectionStatus status;
+};
