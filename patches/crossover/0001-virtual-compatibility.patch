+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_WIFI_H
+#define __WINE_WIFI_H
+
+#define WIFI_MAX_NETWORKS 64
+
+/* Only fixed-size fields, so 32- and 64-bit callers share one layout. */
+struct wifi_network
+{
+    char  ssid[33];          /* empty when the system does not reveal it */
+    BYTE  bssid[6];
+    BYTE  has_bssid;
+    INT32 rssi;              /* dBm */
+    INT32 channel;
+    INT32 band;              /* 1 = 2.4 GHz, 2 = 5 GHz, 3 = 6 GHz, 0 = unknown */
+    INT32 phy;               /* WiFiPhyKind */
+    INT32 security;          /* enum wifi_security */
+    INT32 beacon_ms;
+    BYTE  adhoc;
+    BYTE  current;           /* the network the interface is associated with */
+};
+
+enum wifi_security
+{
+    WIFI_SECURITY_UNKNOWN,
+    WIFI_SECURITY_OPEN,
+    WIFI_SECURITY_WEP,
+    WIFI_SECURITY_WPA_PERSONAL,
+    WIFI_SECURITY_WPA2_PERSONAL,
+    WIFI_SECURITY_WPA3_PERSONAL,
+    WIFI_SECURITY_WPA_ENTERPRISE,
+    WIFI_SECURITY_WPA2_ENTERPRISE,
+    WIFI_SECURITY_WPA3_ENTERPRISE,
+    WIFI_SECURITY_OWE,
+};
+
+struct wifi_info_params
+{
+    BYTE  present;           /* the machine has a Wi-Fi interface */
+    BYTE  power_on;
+    BYTE  associated;
+    BYTE  mac[6];
+    char  name[16];          /* BSD interface name, e.g. en0 */
+    UINT32 count;
+    struct wifi_network networks[WIFI_MAX_NETWORKS];
+};
+
+/* wlanapi.dll exports this for Windows.Devices.WiFi; scan blocks until the scan is done. */
+typedef DWORD (WINAPI *wine_wlan_query_func)( struct wifi_info_params *params, BOOL scan );
+
+#endif /* __WINE_WIFI_H */
