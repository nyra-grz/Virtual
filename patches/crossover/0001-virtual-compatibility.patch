+/* WiFiAvailableNetwork */
+
+struct available_network
+{
+    IWiFiAvailableNetwork iface;
+    LONG ref;
+    struct wifi_network net;
+};
+
+DEFINE_SIMPLE_INSPECTABLE( available_network, IWiFiAvailableNetwork, struct available_network,
+                           L"Windows.Devices.WiFi.WiFiAvailableNetwork" )
+
+static void available_network_destroy( struct available_network *impl ) { free( impl ); }
+
+static HRESULT WINAPI available_network_get_Uptime( IWiFiAvailableNetwork *iface, TimeSpan *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    value->Duration = 0; /* the host does not report how long a network has been up */
+    return S_OK;
+}
+
+static HRESULT WINAPI available_network_get_Ssid( IWiFiAvailableNetwork *iface, HSTRING *value )
+{
+    struct available_network *impl = available_network_from_iface( iface );
+    WCHAR ssid[ARRAY_SIZE(impl->net.ssid)];
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    MultiByteToWideChar( CP_UTF8, 0, impl->net.ssid, -1, ssid, ARRAY_SIZE(ssid) );
+    return WindowsCreateString( ssid, wcslen( ssid ), value );
+}
+
+static HRESULT WINAPI available_network_get_Bssid( IWiFiAvailableNetwork *iface, HSTRING *value )
+{
+    struct available_network *impl = available_network_from_iface( iface );
+    const BYTE *b = impl->net.bssid;
+    WCHAR bssid[18];
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    if (!impl->net.has_bssid) return WindowsCreateString( NULL, 0, value );
+    swprintf( bssid, ARRAY_SIZE(bssid), L"%02x:%02x:%02x:%02x:%02x:%02x", b[0], b[1], b[2], b[3], b[4], b[5] );
+    return WindowsCreateString( bssid, wcslen( bssid ), value );
