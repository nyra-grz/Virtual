+/* Returns the shared volume of a device, creating it with the device's real
+ * channel count and the last saved levels if no process has it yet. */
+struct endpoint_volume_state *endpoint_volume_open(const GUID *guid, IMMDevice *device)
+{
+    struct endpoint_volume_entry *entry;
+    struct endpoint_volume_state *state = NULL;
+    WCHAR name[64];
+    HANDLE mapping;
+    UINT i;
+
+    EnterCriticalSection(&endpoint_cs);
+
+    LIST_FOR_EACH_ENTRY(entry, &endpoint_states, struct endpoint_volume_entry, entry) {
+        if (IsEqualGUID(&entry->guid, guid)) {
+            state = entry->state;
+            goto done;
+        }
+    }
+
+    wcscpy(name, L"WineMMDevEndpointVolume_");
+    StringFromGUID2(guid, name + wcslen(name), 39);
+    if (!(mapping = CreateFileMappingW(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE, 0, sizeof(*state), name)))
+        goto done;
+    if (!(state = MapViewOfFile(mapping, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(*state))) ||
+        !(entry = malloc(sizeof(*entry)))) {
+        if (state) UnmapViewOfFile(state);
+        CloseHandle(mapping);
+        state = NULL;
+        goto done;
+    }
+
+    if (!InterlockedCompareExchange(&state->init, 1, 0)) {
+        state->values.channels = device_channel_count(guid, device);
+        for (i = 0; i < state->values.channels; i++)
+            state->values.levels[i] = VOLUME_MAX_DB;
+        load_values(guid, &state->values);
+        InterlockedExchange(&state->init, 2);
+    } else {
+        /* Another process is setting it up right now; don't wait forever if it died. */
+        for (i = 0; i < 2000 && ReadAcquire(&state->init) != 2; i++)
+            Sleep(1);
+    }
+
+    entry->guid = *guid;
+    entry->mapping = mapping;
+    entry->state = state;
+    list_add_tail(&endpoint_states, &entry->entry);
+
+done:
+    LeaveCriticalSection(&endpoint_cs);
+    return state;
+}
+
+static LONG read_values(const struct endpoint_volume_state *state, struct endpoint_volume_values *values)
+{
+    LONG version;
+
+    for (;;) {
+        version = ReadAcquire(&state->version);
+        if (!(version & 1)) {
+            *values = state->values;
+            MemoryBarrier();
+            if (ReadAcquire(&state->version) == version)
+                return version;
+        }
+        YieldProcessor();
+    }
+}
+
+LONG endpoint_volume_version(const struct endpoint_volume_state *state)
+{
+    return ReadAcquire(&state->version);
+}
+
+/* Linear gain per stream channel; a mono stream follows the master level. */
+LONG endpoint_volume_gains(const struct endpoint_volume_state *state, UINT count, float *gains)
+{
+    struct endpoint_volume_values values;
+    LONG version = read_values(state, &values);
+    float master = db_to_scalar(master_level(&values));
+    UINT i;
+
+    for (i = 0; i < count; i++) {
+        if (values.mute)
+            gains[i] = 0.0f;
+        else if (count > 1 && i < values.channels)
+            gains[i] = db_to_scalar(values.levels[i]);
+        else
+            gains[i] = master;
+    }
+    return version;
+}
