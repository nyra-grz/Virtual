+static const WCHAR *dev_object_string( const DEV_OBJECT *obj, const DEVPROPKEY *key )
+{
+    ULONG i;
+
+    for (i = 0; i < obj->cPropertyCount; i++)
+    {
+        const DEVPROPERTY *prop = &obj->pProperties[i];
+        if (IsEqualDevPropKey( prop->CompKey.Key, *key ) && prop->Type == DEVPROP_TYPE_STRING &&
+            prop->BufferSize >= 2 * sizeof(WCHAR))
+            return prop->Buffer;
+    }
+    return NULL;
+}
+
+/* Friendly name or description of the device instance behind an object. Descriptions can be
+ * stored in the "@file.inf,%key%;Text" form, of which only the text is shown. */
+static HRESULT device_name_from_instance( const WCHAR *instance, HSTRING *name )
+{
+    static const DEVPROPKEY *keys[] = { &DEVPKEY_Device_FriendlyName, &DEVPKEY_Device_DeviceDesc };
+    SP_DEVINFO_DATA dev = {.cbSize = sizeof(dev)};
+    WCHAR buffer[512], *text;
+    HRESULT hr = E_FAIL;
+    DEVPROPTYPE type;
+    HDEVINFO set;
+    ULONG i;
+
+    if ((set = SetupDiCreateDeviceInfoList( NULL, NULL )) == INVALID_HANDLE_VALUE) return E_FAIL;
+    if (SetupDiOpenDeviceInfoW( set, instance, NULL, 0, &dev ))
+    {
+        for (i = 0; i < ARRAY_SIZE(keys) && FAILED(hr); i++)
+        {
+            if (!SetupDiGetDevicePropertyW( set, &dev, keys[i], &type, (BYTE *)buffer, sizeof(buffer) - sizeof(WCHAR), NULL, 0 ) ||
+                type != DEVPROP_TYPE_STRING || !*buffer)
+                continue;
+            buffer[ARRAY_SIZE(buffer) - 1] = 0;
+            text = (*buffer == '@' && wcsrchr( buffer, ';' )) ? wcsrchr( buffer, ';' ) + 1 : buffer;
+            hr = WindowsCreateString( text, wcslen( text ), name );
+        }
+    }
+    SetupDiDestroyDeviceInfoList( set );
+    return hr;
+}
+
+static HRESULT init_device_information( struct device_information *impl, const DEV_OBJECT *obj )
+{
+    const WCHAR *name, *instance;
+    ULONG i;
+
+    /* Interfaces report whether they are enabled; other objects exist only while present. */
+    impl->enabled = TRUE;
+    for (i = 0; i < obj->cPropertyCount; i++)
+    {
+        const DEVPROPERTY *prop = &obj->pProperties[i];
+        if (IsEqualDevPropKey( prop->CompKey.Key, DEVPKEY_DeviceInterface_Enabled ) && prop->Type == DEVPROP_TYPE_BOOLEAN &&
+            prop->BufferSize >= sizeof(DEVPROP_BOOLEAN))
+            impl->enabled = *(DEVPROP_BOOLEAN *)prop->Buffer != DEVPROP_FALSE;
+    }
+
+    impl->is_default = audio_endpoint_is_default( obj->pszObjectId );
+
+    if ((name = dev_object_string( obj, &DEVPKEY_DeviceInterface_FriendlyName )) ||
+        (name = dev_object_string( obj, &DEVPKEY_NAME ))) /* System.ItemNameDisplay */
+        return WindowsCreateString( name, wcslen( name ), &impl->name );
+
+    instance = dev_object_string( obj, &DEVPKEY_Device_InstanceId );
+    if (!instance && obj->ObjectType == DevObjectTypeDevice) instance = obj->pszObjectId;
+    if (instance && SUCCEEDED(device_name_from_instance( instance, &impl->name ))) return S_OK;
+
+    /* Last resort: the instance id still tells the device apart. */
+    name = instance ? instance : obj->pszObjectId;
+    return WindowsCreateString( name, wcslen( name ), &impl->name );
+}
