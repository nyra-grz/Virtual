+static HRESULT WINAPI connection_result_get_ConnectionStatus( IWiFiConnectionResult *iface, WiFiConnectionStatus *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = connection_result_from_iface( iface )->status;
+    return S_OK;
