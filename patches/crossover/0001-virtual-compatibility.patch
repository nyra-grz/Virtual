+#ifdef __APPLE__
+/* Chromium (Chrome, Edge, Electron, CEF) draws from a separate GPU process into the
+ * browser process' windows. On macOS a process cannot draw into another process'
+ * windows, so the page stays black; with the GPU thread in the browser process it
+ * works. Done for Chromium-based programs; VIRTUAL_CHROMIUM_GPU_PROCESS=1 keeps
+ * Chromium's default. */
+static BOOL is_chromium_program( const UNICODE_STRING *image )
+{
+    static const char *exe_names[] = { "msedge.exe", "chrome.exe", "msedgewebview2.exe", "brave.exe",
+                                       "vivaldi.exe", "opera.exe" };
+    static const char *markers[] = { "libcef.dll", "chrome_elf.dll" };
+    char *unix_name = NULL, *slash, *path;
+    struct stat st;
+    BOOL ret = FALSE;
+    unsigned int i;
+    size_t dir_len;
+
+    if (getenv( "VIRTUAL_CHROMIUM_GPU_PROCESS" )) return FALSE;
+    if (!image->Buffer || ntdll_get_unix_file_name( image->Buffer, &unix_name, FILE_OPEN ) || !unix_name) return FALSE;
+    if (!(slash = strrchr( unix_name, '/' )) || !(path = malloc( strlen( unix_name ) + 32 )))
+    {
+        free( unix_name );
+        return FALSE;
+    }
+    dir_len = slash + 1 - unix_name;
+    memcpy( path, unix_name, dir_len );
+    for (i = 0; i < ARRAY_SIZE(exe_names) && !ret; i++) ret = !strcasecmp( slash + 1, exe_names[i] );
+    for (i = 0; i < ARRAY_SIZE(markers) && !ret; i++)
+    {
+        strcpy( path + dir_len, markers[i] );
+        ret = !stat( path, &st );
+    }
+    if (!ret)
+    {
+        /* Electron: icudtl.dat next to resources.pak */
+        strcpy( path + dir_len, "icudtl.dat" );
+        if (!stat( path, &st ))
+        {
+            strcpy( path + dir_len, "resources.pak" );
+            ret = !stat( path, &st );
+        }
+    }
+    free( path );
+    free( unix_name );
+    return ret;
+}
+
+/* appends the switches behind the environment, in the room reserved for it */
+static void add_chromium_switches( RTL_USER_PROCESS_PARAMETERS *params, WCHAR *dst )
+{
+    /* --no-sandbox: Chromium's sandbox needs Windows security features Wine doesn't have;
+     * without it no renderer starts and every tab stays empty. */
+    static const WCHAR gpu[] = {' ','-','-','i','n','-','p','r','o','c','e','s','s','-','g','p','u',0};
+    static const WCHAR sandbox[] = {' ','-','-','n','o','-','s','a','n','d','b','o','x',0};
+    static const WCHAR *switches[] = { gpu, sandbox };
+    static const WCHAR type[] = {'-','-','t','y','p','e','=',0};
+    UNICODE_STRING *cmdline = &params->CommandLine;
+    size_t i, j, len, type_len = ARRAY_SIZE(type) - 1, count = cmdline->Length / sizeof(WCHAR);
+    BOOL present[ARRAY_SIZE(switches)] = {0};
+    WCHAR *p;
+
+    /* Only the browser process; subprocesses (--type=...) like crashpad parse strictly. */
+    for (i = 0; i + type_len <= count; i++)
+        if (!memcmp( cmdline->Buffer + i, type, type_len * sizeof(WCHAR) )) return;
+    for (j = 0; j < ARRAY_SIZE(switches); j++)
+    {
+        for (len = 0; switches[j][len + 1]; len++) ;
+        for (i = 0; i + len <= count && !present[j]; i++)
+            present[j] = !memcmp( cmdline->Buffer + i, switches[j] + 1, len * sizeof(WCHAR) );
+    }
+    if (present[0] && present[1]) return;
+    if (!is_chromium_program( &params->ImagePathName )) return;
+    memcpy( dst, cmdline->Buffer, cmdline->Length );
+    p = dst + count;
+    for (j = 0; j < ARRAY_SIZE(switches); j++)
+    {
+        if (present[j]) continue;
+        for (len = 0; switches[j][len]; len++) ;
+        memcpy( p, switches[j], len * sizeof(WCHAR) );
+        p += len;
+    }
+    *p = 0;
+    cmdline->Buffer = dst;
+    cmdline->Length = (p - dst) * sizeof(WCHAR);
+    cmdline->MaximumLength = cmdline->Length + sizeof(WCHAR);
+}
+#endif
