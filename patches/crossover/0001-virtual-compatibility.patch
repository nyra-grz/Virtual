+    if (FAILED(hr = vector_inspectable_create( &iids, &vector ))) return hr;
+    if (WinHttpGetIEProxyConfigForCurrentUser( &config ) && config.lpszProxy && *config.lpszProxy)
+    {
+        /* With a proxy configured, direct connections are only expected for bypassed hosts. */
+        direct = FALSE;
+        hr = append_proxy_uris( vector, config.lpszProxy );
+    }
+    GlobalFree( config.lpszAutoConfigUrl );
