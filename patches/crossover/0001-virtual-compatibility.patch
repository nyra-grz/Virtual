+static HRESULT WINAPI wifi_adapter_get_NetworkAdapter( IWiFiAdapter *iface, INetworkAdapter **value )
+{
+    struct wifi_info_params *info;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    if (FAILED(hr = query_wifi( FALSE, &info ))) return hr;
+    hr = network_adapter_for_interface( info->name, value );
+    free( info );
+    return hr;
+}
+
+static HRESULT scan_callback( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    struct wifi_adapter *impl = wifi_adapter_from_iface( (IWiFiAdapter *)invoker );
+    ITypedEventHandler_WiFiAdapter_IInspectable **handlers = NULL;
+    struct wifi_info_params *info;
+    struct event_handler *entry;
+    UINT32 count = 0, i;
+    HRESULT hr;
+
+    if (!called_async) return STATUS_PENDING;
+    if (FAILED(hr = query_wifi( TRUE, &info ))) return hr;
+
+    EnterCriticalSection( &impl->cs );
+    free( impl->last_scan );
+    impl->last_scan = info;
+    if ((handlers = calloc( list_count( &impl->handlers ) + 1, sizeof(*handlers) )))
+        LIST_FOR_EACH_ENTRY( entry, &impl->handlers, struct event_handler, entry )
+            ITypedEventHandler_WiFiAdapter_IInspectable_AddRef( (handlers[count++] = entry->handler) );
+    LeaveCriticalSection( &impl->cs );
+
+    /* Outside the lock: a handler may read the new NetworkReport. */
+    for (i = 0; i < count; i++)
+    {
+        ITypedEventHandler_WiFiAdapter_IInspectable_Invoke( handlers[i], &impl->iface, NULL );
+        ITypedEventHandler_WiFiAdapter_IInspectable_Release( handlers[i] );
+    }
+    free( handlers );
+    return S_OK;
+}
+
+static HRESULT WINAPI wifi_adapter_ScanAsync( IWiFiAdapter *iface, IAsyncAction **operation )
+{
+    TRACE( "iface %p, operation %p.\n", iface, operation );
+    if (!operation) return E_POINTER;
+    return async_action_create( (IUnknown *)iface, scan_callback, operation );
+}
+
+static HRESULT WINAPI wifi_adapter_get_NetworkReport( IWiFiAdapter *iface, IWiFiNetworkReport **value )
+{
+    struct wifi_adapter *impl = wifi_adapter_from_iface( iface );
+    struct wifi_info_params *info;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+
+    /* Without a ScanAsync call, report what the host has seen most recently. */
+    EnterCriticalSection( &impl->cs );
+    hr = impl->last_scan ? network_report_create( impl->last_scan, value ) : S_FALSE;
+    LeaveCriticalSection( &impl->cs );
+    if (hr != S_FALSE) return hr;
+
+    if (FAILED(hr = query_wifi( FALSE, &info ))) return hr;
+    hr = network_report_create( info, value );
+    free( info );
+    return hr;
+}
