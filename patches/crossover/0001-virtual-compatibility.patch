+static HRESULT lowercase_string( const WCHAR *str, UINT32 len, HSTRING *out )
+{
+    WCHAR *buf;
+    HRESULT hr;
+    int n;
+
+    if (!len) return WindowsCreateString( str, 0, out );
+    if (!(buf = malloc( len * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    n = LCMapStringEx( LOCALE_NAME_INVARIANT, LCMAP_LOWERCASE, str, len, buf, len, NULL, NULL, 0 );
+    hr = n ? WindowsCreateString( buf, n, out ) : HRESULT_FROM_WIN32( GetLastError() );
+    free( buf );
+    return hr;
+}
+
+/* "(12:34:56:78:9A:BC)" or "12:34:56:78:9a:bc" -> "(12:34:56:78:9A:BC)". */
+static BOOL parse_bluetooth( const WCHAR *str, UINT32 len, WCHAR *out )
+{
+    UINT32 i;
+
+    if (len == 19 && str[0] == '(' && str[18] == ')') { str++; len = 17; }
+    if (len != 17) return FALSE;
+    for (i = 0; i < 17; i++)
+    {
+        if (i % 3 == 2) { if (str[i] != ':') return FALSE; }
+        else if (!iswxdigit( str[i] )) return FALSE;
+    }
+    out[0] = '(';
+    for (i = 0; i < 17; i++) out[i + 1] = towupper( str[i] );
+    out[18] = ')';
+    out[19] = 0;
+    return TRUE;
+}
+
+/* Works out the type and the canonical and display forms of a host name string. */
+static HRESULT parse_hostname( HSTRING raw, HostNameType *type, HSTRING *canonical, HSTRING *display )
+{
+    UINT32 len, i;
+    const WCHAR *str = WindowsGetStringRawBuffer( raw, &len ), *end;
+    WCHAR buf[256], addr[64];
+    ULONG addr_len = ARRAY_SIZE(addr), scope = 0;
+    USHORT port = 0;
+    IN_ADDR in4;
+    IN6_ADDR in6;
+    HRESULT hr;
+    int n;
+
+    *canonical = *display = NULL;
+    if (!len) return E_INVALIDARG;
+    for (i = 0; i < len; i++) if (str[i] <= ' ') return E_INVALIDARG;
+    if (len >= ARRAY_SIZE(buf)) return E_INVALIDARG;
+
+    if (!RtlIpv4StringToAddressW( str, TRUE, &end, &in4 ) && !*end)
+    {
+        *type = HostNameType_Ipv4;
+        RtlIpv4AddressToStringExW( &in4, 0, addr, &addr_len );
+    }
+    else
+    {
+        /* Accept the bracketed form used in URLs, but not a port. */
+        if (str[0] == '[' && str[len - 1] == ']') { memcpy( buf, str + 1, (len - 2) * sizeof(WCHAR) ); buf[len - 2] = 0; }
+        else { memcpy( buf, str, len * sizeof(WCHAR) ); buf[len] = 0; }
+
+        if (!RtlIpv6StringToAddressExW( buf, &in6, &scope, &port ) && !port)
+        {
+            *type = HostNameType_Ipv6;
+            RtlIpv6AddressToStringExW( &in6, scope, 0, addr, &addr_len );
+        }
+        else if (parse_bluetooth( str, len, addr ))
+            *type = HostNameType_Bluetooth;
+        else
+        {
+            /* Domain names: Unicode form for display (IDN decoded), lowercase for comparisons. */
+            *type = HostNameType_DomainName;
+            n = IdnToUnicode( 0, str, len, buf, ARRAY_SIZE(buf) );
+            if (FAILED(hr = n ? WindowsCreateString( buf, n, display ) : WindowsDuplicateString( raw, display ))) return hr;
+            if (FAILED(hr = lowercase_string( WindowsGetStringRawBuffer( *display, NULL ), WindowsGetStringLen( *display ), canonical )))
+            {
+                WindowsDeleteString( *display );
+                *display = NULL;
+            }
+            return hr;
+        }
+    }
+
+    if (FAILED(hr = WindowsCreateString( addr, wcslen( addr ), canonical ))) return hr;
+    if (FAILED(hr = WindowsDuplicateString( *canonical, display )))
+    {
+        WindowsDeleteString( *canonical );
+        *canonical = NULL;
+    }
+    return hr;
+}
