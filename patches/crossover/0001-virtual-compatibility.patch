+static HRESULT from_id_callback( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    struct wifi_info_params *info;
+    IWiFiAdapter *adapter;
+    HSTRING id = (HSTRING)param;
+    WCHAR expected[128];
+    HRESULT hr = S_OK;
+
+    if (FAILED(hr = query_wifi( FALSE, &info ))) return hr;
+    adapter_id( info, expected, ARRAY_SIZE(expected) );
+    result->vt = VT_UNKNOWN;
+    result->punkVal = NULL;
+    if (info->present && !wcsicmp( WindowsGetStringRawBuffer( id, NULL ), expected ) && SUCCEEDED(hr = wifi_adapter_create( &adapter )))
+        result->punkVal = (IUnknown *)adapter;
+    free( info );
+    return hr;
