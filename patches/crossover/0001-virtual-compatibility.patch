+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    if (FAILED(hr = vector_inspectable_create( &iids, &vector ))) return hr;
+    get_internet_adapter( &internet );
+
+    if ((buf = get_adapters()))
+    {
+        for (aa = buf; aa && SUCCEEDED(hr); aa = aa->Next)
+        {
+            if (!adapter_is_connected( aa )) continue;
+            fill_adapter_info( aa, &info );
+            if (FAILED(hr = connection_profile_create( &info, info.if_index == internet.if_index, &profile ))) break;
+            hr = IVector_IInspectable_Append( vector, (IInspectable *)profile );
+            IConnectionProfile_Release( profile );
