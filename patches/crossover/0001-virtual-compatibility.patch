+
+/* CoreWLAN is loaded at run time and driven through the Objective-C runtime, so the
+ * module needs neither Objective-C sources nor a link-time framework dependency. */
+typedef void *id;
+typedef void *SEL;
+
+static id   (*p_objc_getClass)( const char * );
+static SEL  (*p_sel_registerName)( const char * );
+static void *(*p_objc_autoreleasePoolPush)( void );
+static void (*p_objc_autoreleasePoolPop)( void * );
+static void *p_objc_msgSend;
+static pthread_once_t init_once = PTHREAD_ONCE_INIT;
+static BOOL corewlan_loaded;
+
+/* CWPHYMode, CWChannelBand and CWSecurity from CoreWLAN/CoreWLANTypes.h */
+enum { CW_PHY_11A = 1, CW_PHY_11B, CW_PHY_11G, CW_PHY_11N, CW_PHY_11AC, CW_PHY_11AX, CW_PHY_11BE };
+enum { CW_SEC_NONE = 0, CW_SEC_WEP = 1, CW_SEC_WPA_PERSONAL = 2, CW_SEC_WPA_PERSONAL_MIXED = 3,
+       CW_SEC_WPA2_PERSONAL = 4, CW_SEC_PERSONAL = 5, CW_SEC_DYNAMIC_WEP = 6, CW_SEC_WPA_ENTERPRISE = 7,
+       CW_SEC_WPA_ENTERPRISE_MIXED = 8, CW_SEC_WPA2_ENTERPRISE = 9, CW_SEC_ENTERPRISE = 10,
+       CW_SEC_WPA3_PERSONAL = 11, CW_SEC_WPA3_ENTERPRISE = 12, CW_SEC_WPA3_TRANSITION = 13,
+       CW_SEC_OWE = 14, CW_SEC_OWE_TRANSITION = 15 };
+
+static void load_corewlan( void )
+{
+    void *objc = dlopen( "/usr/lib/libobjc.A.dylib", RTLD_NOW );
+
+    if (!objc || !dlopen( "/System/Library/Frameworks/CoreWLAN.framework/CoreWLAN", RTLD_NOW )) return;
+    p_objc_getClass = dlsym( objc, "objc_getClass" );
+    p_sel_registerName = dlsym( objc, "sel_registerName" );
+    p_objc_autoreleasePoolPush = dlsym( objc, "objc_autoreleasePoolPush" );
+    p_objc_autoreleasePoolPop = dlsym( objc, "objc_autoreleasePoolPop" );
+    p_objc_msgSend = dlsym( objc, "objc_msgSend" );
+    corewlan_loaded = p_objc_getClass && p_sel_registerName && p_objc_autoreleasePoolPush &&
+                      p_objc_autoreleasePoolPop && p_objc_msgSend && p_objc_getClass( "CWWiFiClient" );
+}
+
+static SEL sel( const char *name ) { return p_sel_registerName( name ); }
+static id send( id obj, const char *name ) { return obj ? ((id (*)( id, SEL ))p_objc_msgSend)( obj, sel( name ) ) : NULL; }
+static long send_long( id obj, const char *name ) { return obj ? ((long (*)( id, SEL ))p_objc_msgSend)( obj, sel( name ) ) : 0; }
+static BOOL send_bool( id obj, const char *name ) { return obj && ((signed char (*)( id, SEL ))p_objc_msgSend)( obj, sel( name ) ); }
+static id send_index( id obj, const char *name, unsigned long index )
+{
+    return obj ? ((id (*)( id, SEL, unsigned long ))p_objc_msgSend)( obj, sel( name ), index ) : NULL;
+}
+static BOOL send_supports( id obj, const char *name, long value )
+{
+    return obj && ((signed char (*)( id, SEL, long ))p_objc_msgSend)( obj, sel( name ), value );
+}
+
+static void copy_string( id string, char *dst, size_t size )
+{
+    const char *utf8 = string ? (const char *)send( string, "UTF8String" ) : NULL;
+    dst[0] = 0;
+    if (utf8) snprintf( dst, size, "%s", utf8 );
+}
+
+static BOOL parse_mac( id string, BYTE *mac )
+{
+    char text[32];
+    unsigned int b[6];
+
+    copy_string( string, text, sizeof(text) );
+    if (sscanf( text, "%x:%x:%x:%x:%x:%x", &b[0], &b[1], &b[2], &b[3], &b[4], &b[5] ) != 6) return FALSE;
+    for (int i = 0; i < 6; i++) mac[i] = b[i];
+    return TRUE;
+}
+
+static INT32 phy_kind( long mode )
+{
+    switch (mode)
+    {
+    case CW_PHY_11A:  return 4;  /* Ofdm */
+    case CW_PHY_11B:  return 5;  /* Hrdsss */
+    case CW_PHY_11G:  return 6;  /* Erp */
+    case CW_PHY_11N:  return 7;  /* HT */
+    case CW_PHY_11AC: return 8;  /* Vht */
+    case CW_PHY_11AX: return 10; /* HE */
+    case CW_PHY_11BE: return 11; /* Eht */
+    default:          return 0;
+    }
+}
+
+static INT32 security_kind( long security )
+{
+    switch (security)
+    {
+    case CW_SEC_NONE: return WIFI_SECURITY_OPEN;
+    case CW_SEC_WEP: case CW_SEC_DYNAMIC_WEP: return WIFI_SECURITY_WEP;
+    case CW_SEC_WPA_PERSONAL: case CW_SEC_WPA_PERSONAL_MIXED: return WIFI_SECURITY_WPA_PERSONAL;
+    case CW_SEC_WPA2_PERSONAL: case CW_SEC_PERSONAL: return WIFI_SECURITY_WPA2_PERSONAL;
+    case CW_SEC_WPA3_PERSONAL: case CW_SEC_WPA3_TRANSITION: return WIFI_SECURITY_WPA3_PERSONAL;
+    case CW_SEC_WPA_ENTERPRISE: case CW_SEC_WPA_ENTERPRISE_MIXED: return WIFI_SECURITY_WPA_ENTERPRISE;
+    case CW_SEC_WPA2_ENTERPRISE: case CW_SEC_ENTERPRISE: return WIFI_SECURITY_WPA2_ENTERPRISE;
+    case CW_SEC_WPA3_ENTERPRISE: return WIFI_SECURITY_WPA3_ENTERPRISE;
+    case CW_SEC_OWE: case CW_SEC_OWE_TRANSITION: return WIFI_SECURITY_OWE;
+    default: return WIFI_SECURITY_UNKNOWN;
+    }
+}
+
+/* A scanned network only says which modes it supports; report the strongest. */
+static INT32 network_security( id network )
+{
+    static const long order[] = { CW_SEC_WPA3_ENTERPRISE, CW_SEC_WPA2_ENTERPRISE, CW_SEC_WPA_ENTERPRISE,
+                                  CW_SEC_WPA3_PERSONAL, CW_SEC_WPA2_PERSONAL, CW_SEC_WPA_PERSONAL,
+                                  CW_SEC_OWE, CW_SEC_WEP, CW_SEC_NONE };
+    for (unsigned int i = 0; i < ARRAY_SIZE(order); i++)
+        if (send_supports( network, "supportsSecurity:", order[i] )) return security_kind( order[i] );
+    return WIFI_SECURITY_UNKNOWN;
+}
+
+static INT32 network_phy( id network )
+{
+    static const long order[] = { CW_PHY_11BE, CW_PHY_11AX, CW_PHY_11AC, CW_PHY_11N, CW_PHY_11G, CW_PHY_11A, CW_PHY_11B };
+    for (unsigned int i = 0; i < ARRAY_SIZE(order); i++)
+        if (send_supports( network, "supportsPHYMode:", order[i] )) return phy_kind( order[i] );
+    return 0;
+}
+
+static void fill_channel( id channel, struct wifi_network *net )
+{
+    net->channel = send_long( channel, "channelNumber" );
+    net->band = send_long( channel, "channelBand" );
+}
+
+static void get_info( struct wifi_info_params *params, BOOL scan )
+{
+    id client, iface, results, list, current_bssid;
+    struct wifi_network *net;
+    char current[33];
+    void *pool;
+    long count;
+
+    memset( params, 0, sizeof(*params) );
+    pthread_once( &init_once, load_corewlan );
+    if (!corewlan_loaded) return;
+
+    pool = p_objc_autoreleasePoolPush();
+    client = send( p_objc_getClass( "CWWiFiClient" ), "sharedWiFiClient" );
+    if (!(iface = send( client, "interface" ))) goto done;
+
+    params->present = TRUE;
+    params->power_on = send_bool( iface, "powerOn" );
+    copy_string( send( iface, "interfaceName" ), params->name, sizeof(params->name) );
+    parse_mac( send( iface, "hardwareAddress" ), params->mac );
+
+    /* The current network; macOS hides SSID and BSSID without location access. */
+    copy_string( send( iface, "ssid" ), current, sizeof(current) );
+    current_bssid = send( iface, "bssid" );
+    if (send( iface, "wlanChannel" ))
+    {
+        net = &params->networks[params->count++];
+        params->associated = TRUE;
+        net->current = TRUE;
+        memcpy( net->ssid, current, sizeof(current) );
+        net->has_bssid = parse_mac( current_bssid, net->bssid );
+        net->rssi = send_long( iface, "rssiValue" );
+        fill_channel( send( iface, "wlanChannel" ), net );
+        net->phy = phy_kind( send_long( iface, "activePHYMode" ) );
+        net->security = security_kind( send_long( iface, "security" ) );
+    }
+
+    if (scan)
+    {
+        /* scanForNetworksWithName:error: blocks until the scan is done and fills the cache. */
+        ((id (*)( id, SEL, id, id * ))p_objc_msgSend)( iface, sel( "scanForNetworksWithName:error:" ), NULL, NULL );
+    }
+    results = send( iface, "cachedScanResults" );
+    list = send( results, "allObjects" );
+    count = send_long( list, "count" );
+    for (long i = 0; i < count && params->count < WIFI_MAX_NETWORKS; i++)
+    {
+        id network = send_index( list, "objectAtIndex:", i );
+        struct wifi_network scanned = {0};
+
+        copy_string( send( network, "ssid" ), scanned.ssid, sizeof(scanned.ssid) );
+        scanned.has_bssid = parse_mac( send( network, "bssid" ), scanned.bssid );
+        scanned.rssi = send_long( network, "rssiValue" );
+        fill_channel( send( network, "wlanChannel" ), &scanned );
+        scanned.phy = network_phy( network );
+        scanned.security = network_security( network );
+        scanned.beacon_ms = send_long( network, "beaconInterval" );
+        scanned.adhoc = send_bool( network, "ibss" );
+
+        /* Fill in what the scan knows about the current network instead of listing it twice. */
+        if (params->associated && params->networks[0].channel == scanned.channel &&
+            ((params->networks[0].has_bssid && scanned.has_bssid && !memcmp( params->networks[0].bssid, scanned.bssid, 6 )) ||
+             (!params->networks[0].has_bssid && current[0] && !strcmp( current, scanned.ssid ))))
+        {
+            params->networks[0].beacon_ms = scanned.beacon_ms;
+            params->networks[0].adhoc = scanned.adhoc;
+            if (!params->networks[0].phy) params->networks[0].phy = scanned.phy;
+            continue;
+        }
+        params->networks[params->count++] = scanned;
+    }
+
+done:
+    p_objc_autoreleasePoolPop( pool );
+}
+
+#else
+
+static void get_info( struct wifi_info_params *params, BOOL scan )
+{
+    memset( params, 0, sizeof(*params) );
+}
+
+#endif
+
+static NTSTATUS wifi_info( void *args )
+{
+    get_info( args, FALSE );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS wifi_scan( void *args )
+{
+    get_info( args, TRUE );
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    wifi_info,
+    wifi_scan,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+#ifdef _WIN64
+
+/* The parameter block has no pointers, so 32-bit callers use the same entry points. */
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    wifi_info,
+    wifi_scan,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
+
+#endif
