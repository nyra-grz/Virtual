+static HRESULT get_proxy_configuration_async( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    static const struct vector_iids iids =
+    {
+        .iterable = &IID_IIterable_Uri,
+        .iterator = &IID_IIterator_Uri,
+        .vector = &IID_IVector_Uri_private,
+        .view = &IID_IVectorView_Uri,
+    };
+    WINHTTP_CURRENT_USER_IE_PROXY_CONFIG config = {0};
+    IVector_IInspectable *vector;
+    IVectorView_Uri *view = NULL;
+    IProxyConfiguration *proxy;
+    BOOL direct = TRUE;
+    HRESULT hr;
