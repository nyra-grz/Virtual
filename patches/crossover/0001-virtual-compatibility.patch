+
+static NTSTATUS NTAPI ntlm_SpGetContextToken(LSA_SEC_HANDLE handle, HANDLE *token)
+{
+    struct ntlm_ctx *ctx = (struct ntlm_ctx *)handle;
+    WCHAR *expected;
+    HANDLE source;
+    BOOL matches, success;
+    if (!token) return SEC_E_INVALID_TOKEN;
+    *token = NULL;
+    if (!ctx || !ctx->authenticated) return SEC_E_INVALID_HANDLE;
+    if (!ctx->local_auth || !ctx->local_principal) return SEC_E_UNSUPPORTED_FUNCTION;
+    expected = get_local_principal();
+    matches = expected && !wcsicmp(expected, ctx->local_principal);
+    free(expected);
+    if (!matches) return SEC_E_LOGON_DENIED;
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_DUPLICATE | TOKEN_QUERY, &source)) return SEC_E_LOGON_DENIED;
+    success = DuplicateTokenEx(source, TOKEN_QUERY | TOKEN_DUPLICATE | TOKEN_IMPERSONATE, NULL,
+            SecurityImpersonation, TokenImpersonation, token);
+    CloseHandle(source);
+    return success ? SEC_E_OK : SEC_E_LOGON_DENIED;
+}
