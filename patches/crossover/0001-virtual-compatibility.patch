+static ULONG WINAPI hstring_param_AddRef( IUnknown *iface )
+{
+    return InterlockedIncrement( &CONTAINING_RECORD( iface, struct hstring_param, IUnknown_iface )->ref );
+}
+
+static ULONG WINAPI hstring_param_Release( IUnknown *iface )
+{
+    struct hstring_param *impl = CONTAINING_RECORD( iface, struct hstring_param, IUnknown_iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        WindowsDeleteString( impl->value );
+        free( impl );
+    }
+    return ref;
+}
