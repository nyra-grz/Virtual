+static HRESULT find_all_callback( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    static const struct vector_iids iids =
+    {
+        .iterable = &IID_IIterable_WiFiAdapter,
+        .iterator = &IID_IIterator_WiFiAdapter,
+        .vector = &IID_IVector_WiFiAdapter,
+        .view = &IID_IVectorView_WiFiAdapter,
+    };
+    struct wifi_info_params *info;
+    IVectorView_IInspectable *view;
+    IVector_IInspectable *vector;
+    IWiFiAdapter *adapter;
+    HRESULT hr;
+
+    if (FAILED(hr = query_wifi( FALSE, &info ))) return hr;
+    if (SUCCEEDED(hr = vector_inspectable_create( &iids, &vector )))
+    {
+        if (info->present && SUCCEEDED(hr = wifi_adapter_create( &adapter )))
+        {
+            hr = IVector_IInspectable_Append( vector, (IInspectable *)adapter );
+            IWiFiAdapter_Release( adapter );
+        }
+        if (SUCCEEDED(hr) && SUCCEEDED(hr = IVector_IInspectable_GetView( vector, &view )))
+        {
+            result->vt = VT_UNKNOWN;
+            result->punkVal = (IUnknown *)view;
+        }
+        IVector_IInspectable_Release( vector );
+    }
+    free( info );
+    return hr;
+}
