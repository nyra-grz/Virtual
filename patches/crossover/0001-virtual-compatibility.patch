+/* Applies a change under the writer lock; S_FALSE if nothing changed. */
+static HRESULT change_volume(AEVImpl *This, enum volume_change change, UINT chan, float value, const GUID *ctx)
+{
+    struct endpoint_volume_state *state = This->state;
+    struct endpoint_volume_values values;
+    BOOL changed;
+    float delta;
+    UINT i;
+
+    while (InterlockedCompareExchange(&state->lock, 1, 0))
+        YieldProcessor();
+
+    values = state->values;
+    switch (change) {
+    case CHANGE_MASTER:
+        /* Moves all channels together, so the balance stays as it was. */
+        delta = value - master_level(&values);
+        for (i = 0; i < values.channels; i++)
+            values.levels[i] = min(max(values.levels[i] + delta, VOLUME_MIN_DB), VOLUME_MAX_DB);
+        break;
+    case CHANGE_CHANNEL:
+        values.levels[chan] = value;
+        break;
+    case CHANGE_MUTE:
+        values.mute = value != 0.0f;
+        break;
+    }
+
+    changed = memcmp(&values, &state->values, offsetof(struct endpoint_volume_values, context)) != 0;
+    if (changed) {
+        if (ctx)
+            values.context = *ctx;
+        else
+            memset(&values.context, 0, sizeof(values.context));
+        InterlockedIncrement(&state->version);
+        state->values = values;
+        InterlockedIncrement(&state->version);
+    }
+    InterlockedExchange(&state->lock, 0);
+
+    if (!changed)
+        return S_FALSE;
+    save_values(&This->guid, &values);
+    return S_OK;
+}
