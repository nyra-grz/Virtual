+    async_impl_QueryInterface,
+    async_impl_AddRef,
+    async_impl_Release,
+    /* IAsyncInfoImpl */
+    async_impl_put_Completed,
+    async_impl_get_Completed,
+    async_impl_get_Result,
+    async_impl_Start,
+};
