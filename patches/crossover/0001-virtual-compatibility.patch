+static HRESULT WINAPI wifi_adapter_add_AvailableNetworksChanged( IWiFiAdapter *iface, ITypedEventHandler_WiFiAdapter_IInspectable *handler,
+                                                                 EventRegistrationToken *token )
+{
+    struct wifi_adapter *impl = wifi_adapter_from_iface( iface );
+    struct event_handler *entry;
+
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+    if (!handler || !token) return E_POINTER;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    ITypedEventHandler_WiFiAdapter_IInspectable_AddRef( (entry->handler = handler) );
+    EnterCriticalSection( &impl->cs );
+    entry->token.value = ++impl->next_token;
+    list_add_tail( &impl->handlers, &entry->entry );
+    LeaveCriticalSection( &impl->cs );
+    *token = entry->token;
+    return S_OK;
+}
+
+static HRESULT WINAPI wifi_adapter_remove_AvailableNetworksChanged( IWiFiAdapter *iface, EventRegistrationToken token )
+{
+    struct wifi_adapter *impl = wifi_adapter_from_iface( iface );
+    struct event_handler *entry, *found = NULL;
+
+    TRACE( "iface %p, token %#I64x.\n", iface, token.value );
+    EnterCriticalSection( &impl->cs );
+    LIST_FOR_EACH_ENTRY( entry, &impl->handlers, struct event_handler, entry )
+    {
+        if (entry->token.value != token.value) continue;
+        list_remove( &entry->entry );
+        found = entry;
+        break;
+    }
+    LeaveCriticalSection( &impl->cs );
+    if (found)
+    {
+        ITypedEventHandler_WiFiAdapter_IInspectable_Release( found->handler );
+        free( found );
+    }
+    return S_OK;
+}
