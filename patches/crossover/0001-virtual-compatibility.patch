+{
+    struct connection_result *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->iface.lpVtbl = &connection_result_vtbl;
+    impl->ref = 1;
+    impl->status = status;
+    *out = &impl->iface;
+    return S_OK;
+}
