+static HRESULT connect_callback( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    IWiFiAvailableNetwork *network = (IWiFiAvailableNetwork *)param;
+    IWiFiConnectionResult *connection;
+    WiFiConnectionStatus status;
+    HRESULT hr;
+
+    /* Joining networks belongs to macOS; a Windows program is only told it is connected
+     * to the network the Mac already uses. */
+    if (network && network->lpVtbl == &available_network_vtbl && available_network_from_iface( network )->net.current)
+        status = WiFiConnectionStatus_Success;
+    else
+        status = WiFiConnectionStatus_AccessRevoked;
+    if (FAILED(hr = connection_result_create( status, &connection ))) return hr;
+    result->vt = VT_UNKNOWN;
+    result->punkVal = (IUnknown *)connection;
+    return S_OK;
+}
+
+static HRESULT connect_async( IWiFiAdapter *iface, IWiFiAvailableNetwork *network, IAsyncOperation_WiFiConnectionResult **operation )
+{
+    if (!network || !operation) return E_POINTER;
+    return async_operation_inspectable_create( &IID_IAsyncOperation_WiFiConnectionResult, (IUnknown *)iface, (IUnknown *)network,
+                                               connect_callback, (IAsyncOperation_IInspectable **)operation );
+}
