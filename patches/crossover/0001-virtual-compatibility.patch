+static HRESULT WINAPI available_network_get_SecuritySettings( IWiFiAvailableNetwork *iface, INetworkSecuritySettings **value )
+{
+    /* Values past Ihv (Wpa3Sae 11, Owe 12, Wpa3Enterprise 13; Gcmp 10) exist since Windows 10 2004. */
+    static const struct { int auth, encryption; } map[] =
+    {
+        [WIFI_SECURITY_UNKNOWN]         = { NetworkAuthenticationType_Unknown, NetworkEncryptionType_Unknown },
+        [WIFI_SECURITY_OPEN]            = { NetworkAuthenticationType_Open80211, NetworkEncryptionType_None },
+        [WIFI_SECURITY_WEP]             = { NetworkAuthenticationType_SharedKey80211, NetworkEncryptionType_Wep },
+        [WIFI_SECURITY_WPA_PERSONAL]    = { NetworkAuthenticationType_WpaPsk, NetworkEncryptionType_Tkip },
+        [WIFI_SECURITY_WPA2_PERSONAL]   = { NetworkAuthenticationType_RsnaPsk, NetworkEncryptionType_Ccmp },
+        [WIFI_SECURITY_WPA3_PERSONAL]   = { 11, NetworkEncryptionType_Ccmp },
+        [WIFI_SECURITY_WPA_ENTERPRISE]  = { NetworkAuthenticationType_Wpa, NetworkEncryptionType_Tkip },
+        [WIFI_SECURITY_WPA2_ENTERPRISE] = { NetworkAuthenticationType_Rsna, NetworkEncryptionType_Ccmp },
+        [WIFI_SECURITY_WPA3_ENTERPRISE] = { 13, 10 },
+        [WIFI_SECURITY_OWE]             = { 12, NetworkEncryptionType_Ccmp },
+    };
+    INT32 security = available_network_from_iface( iface )->net.security;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    if (security < 0 || security >= ARRAY_SIZE(map)) security = WIFI_SECURITY_UNKNOWN;
+    return network_security_settings_create( map[security].auth, map[security].encryption, value );
+}
