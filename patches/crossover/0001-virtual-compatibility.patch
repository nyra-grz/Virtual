+#include <stdio.h>
+
+#include "private.h"
+#include "setupapi.h"
+#include "devpkey.h"
+#include "initguid.h"
+#include "mmdeviceapi.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(enumeration);
+
+/* Setup class of Windows' audio endpoint devices ("AudioEndpoint"). */
+static const GUID audio_endpoint_class = {0xc166523c, 0xfe0c, 0x4a94, {0xa5, 0x86, 0xf1, 0xa8, 0x0c, 0xfb, 0xbf, 0x3e}};
+
+static CRITICAL_SECTION audio_cs;
+static CRITICAL_SECTION_DEBUG audio_cs_debug =
+{
+    0, 0, &audio_cs,
+    { &audio_cs_debug.ProcessLocksList, &audio_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": audio_cs") }
+};
+static CRITICAL_SECTION audio_cs = { &audio_cs_debug, -1, 0, 0, 0, 0 };
+
+/* setupapi treats an interface as enabled when <interface key>\#\Control has Linked = 1. */
+void device_interface_set_linked( HDEVINFO set, SP_DEVICE_INTERFACE_DATA *iface, BOOL linked )
+{
+    WCHAR buffer[sizeof(SP_DEVICE_INTERFACE_DETAIL_DATA_W) / sizeof(WCHAR) + 512], path[1024], guid[39];
+    SP_DEVICE_INTERFACE_DETAIL_DATA_W *detail = (SP_DEVICE_INTERFACE_DETAIL_DATA_W *)buffer;
+    DWORD value = linked;
+    WCHAR *symlink;
+    HKEY key;
+
+    detail->cbSize = sizeof(*detail);
+    if (!SetupDiGetDeviceInterfaceDetailW( set, iface, detail, sizeof(buffer), NULL, NULL )) return;
+    if (wcslen( detail->DevicePath ) < 4) return;
+    StringFromGUID2( &iface->InterfaceClassGuid, guid, ARRAY_SIZE(guid) );
+    symlink = detail->DevicePath;
+    symlink[0] = symlink[1] = symlink[3] = '#';
+    swprintf( path, ARRAY_SIZE(path), L"System\\CurrentControlSet\\Control\\DeviceClasses\\%s\\%s\\#\\Control", guid, symlink );
+    if (RegCreateKeyExW( HKEY_LOCAL_MACHINE, path, 0, NULL, REG_OPTION_VOLATILE, KEY_SET_VALUE, NULL, &key, NULL )) return;
+    RegSetValueExW( key, L"Linked", 0, REG_DWORD, (BYTE *)&value, sizeof(value) );
+    RegCloseKey( key );
+}
+
+static void register_endpoint( HDEVINFO set, IMMDevice *device )
+{
+    SP_DEVICE_INTERFACE_DATA iface = {.cbSize = sizeof(iface)};
+    SP_DEVINFO_DATA dev = {.cbSize = sizeof(dev)};
+    PROPVARIANT name = {.vt = VT_EMPTY};
+    WCHAR *id = NULL, instance[256];
+    IPropertyStore *store;
+    IMMEndpoint *endpoint;
+    EDataFlow flow;
+    DWORD state = 0;
+
+    if (FAILED(IMMDevice_GetId( device, &id ))) return;
+    if (FAILED(IMMDevice_QueryInterface( device, &IID_IMMEndpoint, (void **)&endpoint ))) goto done;
+    if (FAILED(IMMEndpoint_GetDataFlow( endpoint, &flow ))) flow = eAll;
+    IMMEndpoint_Release( endpoint );
+    if (flow != eRender && flow != eCapture) goto done;
+    IMMDevice_GetState( device, &state );
+
+    /* Windows names these software devices SWD\MMDEVAPI\<endpoint id>. */
+    swprintf( instance, ARRAY_SIZE(instance), L"SWD\\MMDEVAPI\\%s", id );
+    if (!SetupDiOpenDeviceInfoW( set, instance, NULL, 0, &dev ) &&
+        (!SetupDiCreateDeviceInfoW( set, instance, &audio_endpoint_class, NULL, NULL, 0, &dev ) ||
+         !SetupDiRegisterDeviceInfo( set, &dev, 0, NULL, NULL, NULL )))
+    {
+        WARN( "failed to register %s, error %lu.\n", debugstr_w(instance), GetLastError() );
+        goto done;
+    }
+    if (!SetupDiCreateDeviceInterfaceW( set, &dev, flow == eRender ? &DEVINTERFACE_AUDIO_RENDER : &DEVINTERFACE_AUDIO_CAPTURE,
+                                        NULL, 0, &iface ))
+    {
+        WARN( "failed to create interface for %s, error %lu.\n", debugstr_w(instance), GetLastError() );
+        goto done;
+    }
+
+    if (SUCCEEDED(IMMDevice_OpenPropertyStore( device, STGM_READ, &store )))
+    {
+        if (SUCCEEDED(IPropertyStore_GetValue( store, (const PROPERTYKEY *)&DEVPKEY_Device_FriendlyName, &name )) &&
+            name.vt == VT_LPWSTR && name.pwszVal)
+        {
+            DWORD size = (wcslen( name.pwszVal ) + 1) * sizeof(WCHAR);
+            SetupDiSetDevicePropertyW( set, &dev, &DEVPKEY_Device_FriendlyName, DEVPROP_TYPE_STRING, (BYTE *)name.pwszVal, size, 0 );
+            SetupDiSetDeviceInterfacePropertyW( set, &iface, &DEVPKEY_DeviceInterface_FriendlyName, DEVPROP_TYPE_STRING,
+                                                (BYTE *)name.pwszVal, size, 0 );
+        }
+        PropVariantClear( &name );
+        IPropertyStore_Release( store );
+    }
+
+    /* Only endpoints that are currently plugged in and enabled count as enabled interfaces. */
+    device_interface_set_linked( set, &iface, state == DEVICE_STATE_ACTIVE );
+    TRACE( "registered %s, state %#lx.\n", debugstr_w(instance), state );
+
+done:
+    CoTaskMemFree( id );
+}
+
+/* Makes the audio endpoints known to mmdevapi (the real Mac speakers, microphones, headsets ...)
+ * visible as device interfaces, as on Windows, so queries, filters and watchers find them. */
+void audio_endpoints_sync( void )
+{
+    IMMDeviceCollection *devices;
+    IMMDeviceEnumerator *devenum;
+    IMMDevice *device;
+    UINT count = 0, i;
+    HDEVINFO set;
+    HRESULT init;
+
+    init = CoInitializeEx( NULL, COINIT_MULTITHREADED );
+    if (FAILED(CoCreateInstance( &CLSID_MMDeviceEnumerator, NULL, CLSCTX_INPROC_SERVER, &IID_IMMDeviceEnumerator, (void **)&devenum )))
+        goto done;
+
+    EnterCriticalSection( &audio_cs );
+    if ((set = SetupDiCreateDeviceInfoList( &audio_endpoint_class, NULL )) != INVALID_HANDLE_VALUE)
+    {
+        if (SUCCEEDED(IMMDeviceEnumerator_EnumAudioEndpoints( devenum, eAll, DEVICE_STATEMASK_ALL, &devices )))
+        {
+            IMMDeviceCollection_GetCount( devices, &count );
+            for (i = 0; i < count; i++)
+            {
+                if (FAILED(IMMDeviceCollection_Item( devices, i, &device ))) continue;
+                register_endpoint( set, device );
+                IMMDevice_Release( device );
+            }
+            IMMDeviceCollection_Release( devices );
+        }
+        SetupDiDestroyDeviceInfoList( set );
+    }
+    LeaveCriticalSection( &audio_cs );
+    IMMDeviceEnumerator_Release( devenum );
+
+done:
+    if (SUCCEEDED(init)) CoUninitialize();
+}
+
+/* Is this the interface of the default (console) audio endpoint of its direction? */
+BOOL audio_endpoint_is_default( const WCHAR *interface_id )
+{
+    static const WCHAR prefix[] = L"\\\\?\\SWD#MMDEVAPI#";
+    const WCHAR *id = interface_id + ARRAY_SIZE(prefix) - 1, *end;
+    IMMDeviceEnumerator *devenum;
+    WCHAR *default_id;
+    IMMDevice *device;
+    BOOL ret = FALSE;
+    EDataFlow flow;
+    HRESULT init;
+
+    if (!interface_id || wcsnicmp( interface_id, prefix, ARRAY_SIZE(prefix) - 1 )) return FALSE;
+    if (!(end = wcschr( id, '#' ))) return FALSE;
+    if (!wcsnicmp( end + 1, L"{e6327cad-dcec-4949-ae8a-991e976a79d2}", 38 )) flow = eRender;
+    else if (!wcsnicmp( end + 1, L"{2eef81be-33fa-4800-9670-1cd474972c3f}", 38 )) flow = eCapture;
+    else return FALSE;
+
+    init = CoInitializeEx( NULL, COINIT_MULTITHREADED );
+    if (SUCCEEDED(CoCreateInstance( &CLSID_MMDeviceEnumerator, NULL, CLSCTX_INPROC_SERVER, &IID_IMMDeviceEnumerator, (void **)&devenum )))
+    {
+        if (SUCCEEDED(IMMDeviceEnumerator_GetDefaultAudioEndpoint( devenum, flow, eConsole, &device )))
+        {
+            if (SUCCEEDED(IMMDevice_GetId( device, &default_id )))
+            {
+                ret = wcslen( default_id ) == end - id && !wcsnicmp( default_id, id, end - id );
+                CoTaskMemFree( default_id );
+            }
+            IMMDevice_Release( device );
+        }
+        IMMDeviceEnumerator_Release( devenum );
+    }
+    if (SUCCEEDED(init)) CoUninitialize();
+    return ret;
+}
