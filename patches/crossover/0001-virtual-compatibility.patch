+
+static HRESULT WINAPI available_network_get_SignalBars( IWiFiAvailableNetwork *iface, BYTE *value )
+{
+    INT32 rssi = available_network_from_iface( iface )->net.rssi;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    /* The four bars of the Windows network icon. */
+    if (rssi >= -60) *value = 4;
+    else if (rssi >= -67) *value = 3;
+    else if (rssi >= -75) *value = 2;
+    else if (rssi >= -85) *value = 1;
+    else *value = 0;
+    return S_OK;
+}
