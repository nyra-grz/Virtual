+        .vector = &IID_IVector_EndpointPair_private,
+        .view = &IID_IVectorView_EndpointPair,
+    };
+    IVector_IInspectable *vector;
+    IIterator_EndpointPair *iterator;
+    IEndpointPair *pair;
+    boolean valid = FALSE;
+    HRESULT hr;
+
+    TRACE( "iface %p, endpoint %p, options %d, value %p.\n", iface, endpoint, options, value );
+
+    if (!value) return E_POINTER;
+    if (!endpoint) return E_INVALIDARG;
+    if (FAILED(hr = vector_inspectable_create( &iids, &vector ))) return hr;
+
+    /* The pairs keep their order: there is no destination address selection policy (RFC 6724) here. */
+    if (SUCCEEDED(hr = IIterable_EndpointPair_First( endpoint, &iterator )))
+    {
+        hr = IIterator_EndpointPair_get_HasCurrent( iterator, &valid );
+        while (SUCCEEDED(hr) && valid)
+        {
+            if (FAILED(hr = IIterator_EndpointPair_get_Current( iterator, &pair ))) break;
+            hr = IVector_IInspectable_Append( vector, (IInspectable *)pair );
+            IEndpointPair_Release( pair );
+            if (SUCCEEDED(hr)) hr = IIterator_EndpointPair_MoveNext( iterator, &valid );
+        }
+        IIterator_EndpointPair_Release( iterator );
+    }
+
+    if (SUCCEEDED(hr)) hr = IVector_IInspectable_GetView( vector, (IVectorView_IInspectable **)value );
+    IVector_IInspectable_Release( vector );
+    return hr;
+}
+
+/* NetworkStatusChanged: a thread compares the network state every two seconds while
+ * handlers are registered, and calls them when it changes. */
+
+struct status_handler
+{
+    struct list entry;
+    INetworkStatusChangedEventHandler *handler;
+    EventRegistrationToken token;
+};
+
+static struct list status_handlers = LIST_INIT( status_handlers );
+static LONG64 next_status_token = 1;
+static HANDLE status_thread;
+static CRITICAL_SECTION status_cs;
+static CRITICAL_SECTION_DEBUG status_cs_debug =
+{
+    0, 0, &status_cs,
+    { &status_cs_debug.ProcessLocksList, &status_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": status_cs") }
+};
+static CRITICAL_SECTION status_cs = { &status_cs_debug, -1, 0, 0, 0, 0 };
+
+static UINT64 network_state_hash( void )
+{
+    NLM_CONNECTIVITY connectivity = NLM_CONNECTIVITY_DISCONNECTED;
+    const IP_ADAPTER_UNICAST_ADDRESS *ua;
+    IP_ADAPTER_ADDRESSES *buf, *aa;
+    UINT64 hash = 0xcbf29ce484222325ull;
+
+#define MIX( data, size ) do { const BYTE *b_ = (const BYTE *)(data); size_t i_; \
+    for (i_ = 0; i_ < (size); i_++) hash = (hash ^ b_[i_]) * 0x100000001b3ull; } while (0)
+
+    get_connectivity( &connectivity );
+    MIX( &connectivity, sizeof(connectivity) );
+    if ((buf = get_adapters()))
+    {
+        for (aa = buf; aa; aa = aa->Next)
+        {
+            if (!adapter_is_connected( aa )) continue;
+            MIX( &aa->IfIndex, sizeof(aa->IfIndex) );
+            MIX( &aa->IfType, sizeof(aa->IfType) );
+            { BYTE gateway = !!aa->FirstGatewayAddress; MIX( &gateway, 1 ); }
+            for (ua = aa->FirstUnicastAddress; ua; ua = ua->Next)
+                MIX( ua->Address.lpSockaddr, ua->Address.iSockaddrLength );
+        }
+        free( buf );
+    }
+#undef MIX
+    return hash;
+}
+
+static DWORD WINAPI status_thread_proc( void *arg )
+{
+    UINT64 state, last = network_state_hash();
+    INetworkStatusChangedEventHandler **handlers;
+    struct status_handler *entry;
+    unsigned int count, i;
+
+    SetThreadDescription( GetCurrentThread(), L"wine_connectivity_status" );
+    CoInitializeEx( NULL, COINIT_MULTITHREADED );
+    for (;;)
+    {
+        Sleep( 2000 );
+        state = network_state_hash();
+
+        EnterCriticalSection( &status_cs );
+        if (list_empty( &status_handlers ))
+        {
+            CloseHandle( status_thread );
+            status_thread = NULL;
+            LeaveCriticalSection( &status_cs );
+            break;
+        }
+        if (state == last)
+        {
+            LeaveCriticalSection( &status_cs );
+            continue;
+        }
+        last = state;
+        count = list_count( &status_handlers );
+        if ((handlers = malloc( count * sizeof(*handlers) )))
+        {
+            i = 0;
+            LIST_FOR_EACH_ENTRY( entry, &status_handlers, struct status_handler, entry )
+            {
+                handlers[i] = entry->handler;
+                INetworkStatusChangedEventHandler_AddRef( handlers[i++] );
+            }
+        }
+        LeaveCriticalSection( &status_cs );
+
+        TRACE( "network status changed, notifying %u handler(s).\n", count );
+        for (i = 0; handlers && i < count; i++)
+        {
+            INetworkStatusChangedEventHandler_Invoke( handlers[i], NULL );
+            INetworkStatusChangedEventHandler_Release( handlers[i] );
+        }
+        free( handlers );
+    }
+    CoUninitialize();
+    return 0;
 }
 
 static HRESULT WINAPI network_information_statics_add_NetworkStatusChanged( INetworkInformationStatics *iface, INetworkStatusChangedEventHandler *handler,
                                                                             EventRegistrationToken *cookie )
 {
-    FIXME( "iface %p, handler %p, cookie %p stub!\n", iface, handler, cookie );
-    *cookie = dummy_cookie;
+    struct status_handler *entry;
+
+    TRACE( "iface %p, handler %p, cookie %p.\n", iface, handler, cookie );
+
+    if (!cookie) return E_POINTER;
+    if (!handler) return E_INVALIDARG;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+
+    entry->handler = handler;
+    INetworkStatusChangedEventHandler_AddRef( handler );
+    entry->token.value = InterlockedIncrement64( &next_status_token );
+
+    EnterCriticalSection( &status_cs );
+    list_add_tail( &status_handlers, &entry->entry );
+    if (!status_thread) status_thread = CreateThread( NULL, 0, status_thread_proc, NULL, 0, NULL );
+    LeaveCriticalSection( &status_cs );
+
+    *cookie = entry->token;
     return S_OK;
 }
 
 static HRESULT WINAPI network_information_statics_remove_NetworkStatusChanged( INetworkInformationStatics *iface, EventRegistrationToken cookie )
 {
-    FIXME( "iface %p, cookie %#I64x stub!\n", iface, cookie.value );
+    struct status_handler *entry, *found = NULL;
+
+    TRACE( "iface %p, cookie %#I64x.\n", iface, cookie.value );
+
+    EnterCriticalSection( &status_cs );
+    LIST_FOR_EACH_ENTRY( entry, &status_handlers, struct status_handler, entry )
+    {
+        if (entry->token.value != cookie.value) continue;
+        list_remove( &entry->entry );
+        found = entry;
+        break;
+    }
+    LeaveCriticalSection( &status_cs );
+
+    if (!found) return S_OK;
+    INetworkStatusChangedEventHandler_Release( found->handler );
+    free( found );
     return S_OK;
 }
 
