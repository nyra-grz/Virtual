+        TRACE( "iface %p, value %p.\n", iface, value );                                                \
+        return WindowsCreateString( class_name, wcslen( class_name ), value );                         \
+    }                                                                                                  \
+    static HRESULT WINAPI pfx##_GetTrustLevel( iface_type *iface, TrustLevel *trust_level )            \
