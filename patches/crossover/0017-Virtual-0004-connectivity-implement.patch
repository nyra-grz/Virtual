+/* Adapters, as GetAdaptersAddresses reports them. */
+
+static IP_ADAPTER_ADDRESSES *get_adapters( void )
+{
+    ULONG flags = GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST | GAA_FLAG_SKIP_DNS_SERVER | GAA_FLAG_INCLUDE_GATEWAYS;
+    IP_ADAPTER_ADDRESSES *buf = NULL;
+    ULONG size = 15000, err;
+
+    do
+    {
+        free( buf );
+        if (!(buf = malloc( size ))) return NULL;
+        err = GetAdaptersAddresses( AF_UNSPEC, flags, NULL, buf, &size );
+    } while (err == ERROR_BUFFER_OVERFLOW);
+
+    if (err == ERROR_SUCCESS) return buf;
+    free( buf );
+    return NULL;
+}
+
+static BOOL is_link_local( const SOCKADDR *addr )
+{
+    if (addr->sa_family == AF_INET6) return IN6_IS_ADDR_LINKLOCAL( &((const SOCKADDR_IN6 *)addr)->sin6_addr );
+    if (addr->sa_family == AF_INET)
+    {
+        const BYTE *bytes = (const BYTE *)&((const SOCKADDR_IN *)addr)->sin_addr;
+        return bytes[0] == 169 && bytes[1] == 254;
+    }
+    return FALSE;
+}
+
+/* An adapter carries a connection profile if it is up, is a real network link and has a
+ * gateway or at least one routable address (link-local only links such as AWDL do not count). */
+static BOOL adapter_is_connected( const IP_ADAPTER_ADDRESSES *aa )
+{
+    const IP_ADAPTER_UNICAST_ADDRESS *ua;
+
+    if (aa->OperStatus != IfOperStatusUp) return FALSE;
+    switch (aa->IfType)
+    {
+    case IF_TYPE_ETHERNET_CSMACD:
+    case IF_TYPE_IEEE80211:
+    case IF_TYPE_PPP:
+    case IF_TYPE_WWANPP:
+    case IF_TYPE_WWANPP2:
+        break;
+    default:
+        return FALSE;
+    }
+    if (aa->FirstGatewayAddress) return TRUE;
+    for (ua = aa->FirstUnicastAddress; ua; ua = ua->Next)
+        if (!is_link_local( ua->Address.lpSockaddr )) return TRUE;
+    return FALSE;
+}
+
+static void fill_adapter_info( const IP_ADAPTER_ADDRESSES *aa, struct adapter_info *info )
+{
+    NET_LUID luid;
+
+    memset( info, 0, sizeof(*info) );
+    /* Same id as netprofm uses for the adapter's network and connection. */
+    if (!ConvertInterfaceIndexToLuid( aa->IfIndex, &luid )) ConvertInterfaceLuidToGuid( &luid, &info->id );
+    info->if_index = aa->IfIndex;
+    info->if_type = aa->IfType;
+    info->transmit_speed = aa->TransmitLinkSpeed;
+    info->receive_speed = aa->ReceiveLinkSpeed;
+    if (aa->FriendlyName) lstrcpynW( info->name, aa->FriendlyName, ARRAY_SIZE(info->name) );
+}
+
+/* The adapter Windows would use to reach the internet: the best route to a public address. */
+static BOOL get_internet_adapter( struct adapter_info *info )
+{
+    IP_ADAPTER_ADDRESSES *buf, *aa;
+    SOCKADDR_IN sin = {.sin_family = AF_INET};
+    SOCKADDR_IN6 sin6 = {.sin6_family = AF_INET6};
+    DWORD index = 0;
+    BOOL found = FALSE;
+
+    sin.sin_addr.s_addr = 0x08080808; /* 8.8.8.8 in any byte order */
+    sin6.sin6_addr.s6_bytes[0] = 0x20; sin6.sin6_addr.s6_bytes[1] = 0x01;
+    sin6.sin6_addr.s6_bytes[2] = 0x48; sin6.sin6_addr.s6_bytes[3] = 0x60;
+    sin6.sin6_addr.s6_bytes[15] = 0x88;
+    if (GetBestInterfaceEx( (SOCKADDR *)&sin, &index ) && GetBestInterfaceEx( (SOCKADDR *)&sin6, &index )) index = 0;
+
+    if (!(buf = get_adapters())) return FALSE;
+    for (aa = buf; aa && !found; aa = aa->Next)
+        if (adapter_is_connected( aa ) && aa->FirstGatewayAddress && (!index || aa->IfIndex == index))
+        {
+            fill_adapter_info( aa, info );
+            found = TRUE;
+        }
+    free( buf );
+    return found;
+}
+
+/* Windows names unnamed networks after their medium; the Wi-Fi SSID is not available to Wine on macOS. */
+static const WCHAR *profile_name( const struct adapter_info *adapter )
+{
+    switch (adapter->if_type)
+    {
+    case IF_TYPE_IEEE80211: return L"Wi-Fi";
+    case IF_TYPE_WWANPP:
+    case IF_TYPE_WWANPP2: return L"Cellular";
+    case IF_TYPE_ETHERNET_CSMACD: return L"Ethernet";
+    default: return adapter->name;
+    }
+}
+
+static BOOL adapter_has_gateway( const struct adapter_info *adapter )
+{
+    IP_ADAPTER_ADDRESSES *buf, *aa;
+    BOOL ret = FALSE;
+
+    if (!(buf = get_adapters())) return FALSE;
+    for (aa = buf; aa; aa = aa->Next)
+        if (aa->IfIndex == adapter->if_index) ret = aa->FirstGatewayAddress != NULL;
+    free( buf );
+    return ret;
+}
+
+static HRESULT get_connectivity( NLM_CONNECTIVITY *connectivity )
+{
+    INetworkListManager *manager;
+    HRESULT hr;
+
+    if (FAILED(hr = CoCreateInstance( &CLSID_NetworkListManager, NULL, CLSCTX_INPROC_SERVER,
+                                      &IID_INetworkListManager, (void **)&manager ))) return hr;
+    hr = INetworkListManager_GetConnectivity( manager, connectivity );
+    INetworkListManager_Release( manager );
+    return hr;
+}
 
