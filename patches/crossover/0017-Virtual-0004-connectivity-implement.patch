+/* "http=proxy:8080;https=proxy:8443" or "proxy:8080" -> one Uri per entry. */
+static HRESULT append_proxy_uris( IVector_IInspectable *vector, const WCHAR *list )
+{
+    IUriRuntimeClassFactory *factory;
+    WCHAR entry[512], uri_str[600];
+    const WCHAR *p = list, *end;
+    IUriRuntimeClass *uri;
+    HSTRING class_name, str;
+    HRESULT hr;
+
+    if (FAILED(hr = WindowsCreateString( RuntimeClass_Windows_Foundation_Uri, wcslen( RuntimeClass_Windows_Foundation_Uri ), &class_name ))) return hr;
+    hr = RoGetActivationFactory( class_name, &IID_IUriRuntimeClassFactory, (void **)&factory );
+    WindowsDeleteString( class_name );
+    if (FAILED(hr)) return hr;
+
+    while (*p && SUCCEEDED(hr))
+    {
+        const WCHAR *host;
+        size_t n;
+
+        while (*p == ';' || *p == ' ') p++;
+        for (end = p; *end && *end != ';' && *end != ' '; end++) ;
+        n = min( (size_t)(end - p), ARRAY_SIZE(entry) - 1 );
+        memcpy( entry, p, n * sizeof(WCHAR) );
+        entry[n] = 0;
+        p = end;
+        if (!n) continue;
+
+        host = wcschr( entry, '=' ) ? wcschr( entry, '=' ) + 1 : entry;
+        if (wcsstr( host, L"://" )) lstrcpynW( uri_str, host, ARRAY_SIZE(uri_str) );
+        else swprintf( uri_str, ARRAY_SIZE(uri_str), L"http://%s", host );
+
+        if (FAILED(hr = WindowsCreateString( uri_str, wcslen( uri_str ), &str ))) break;
+        if (SUCCEEDED(IUriRuntimeClassFactory_CreateUri( factory, str, &uri )))
+        {
+            hr = IVector_IInspectable_Append( vector, (IInspectable *)uri );
+            IUriRuntimeClass_Release( uri );
+        }
+        WindowsDeleteString( str );
+    }
+
+    IUriRuntimeClassFactory_Release( factory );
+    return hr;
+}
