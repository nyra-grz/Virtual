+static HRESULT WINAPI network_information_statics_GetConnectionProfiles( INetworkInformationStatics *iface, IVectorView_ConnectionProfile **value )
+{
+    static const struct vector_iids iids =
+    {
+        .iterable = &IID_IIterable_ConnectionProfile,
+        .iterator = &IID_IIterator_ConnectionProfile,
+        .vector = &IID_IVector_ConnectionProfile,
+        .view = &IID_IVectorView_ConnectionProfile,
+    };
+    struct adapter_info info, internet = {0};
+    IP_ADAPTER_ADDRESSES *buf, *aa;
+    IVector_IInspectable *vector;
+    IConnectionProfile *profile;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    if (FAILED(hr = vector_inspectable_create( &iids, &vector ))) return hr;
+    get_internet_adapter( &internet );
+
+    if ((buf = get_adapters()))
+    {
+        for (aa = buf; aa && SUCCEEDED(hr); aa = aa->Next)
+        {
+            if (!adapter_is_connected( aa )) continue;
+            fill_adapter_info( aa, &info );
+            if (FAILED(hr = connection_profile_create( &info, info.if_index == internet.if_index, &profile ))) break;
+            hr = IVector_IInspectable_Append( vector, (IInspectable *)profile );
+            IConnectionProfile_Release( profile );
+        }
+        free( buf );
+    }
+
+    if (SUCCEEDED(hr)) hr = IVector_IInspectable_GetView( vector, (IVectorView_IInspectable **)value );
+    IVector_IInspectable_Release( vector );
     return hr;
 }
 
+static HRESULT WINAPI network_information_statics_GetInternetConnectionProfile( INetworkInformationStatics *iface, IConnectionProfile **value )
+{
+    NLM_CONNECTIVITY connectivity = NLM_CONNECTIVITY_DISCONNECTED;
+    struct adapter_info info;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (FAILED(hr = get_connectivity( &connectivity ))) return hr;
+    /* Like Windows, there is no internet profile while there is no connection at all. */
+    if (connectivity == NLM_CONNECTIVITY_DISCONNECTED || !get_internet_adapter( &info )) return S_OK;
+    return connection_profile_create( &info, TRUE, value );
+}
