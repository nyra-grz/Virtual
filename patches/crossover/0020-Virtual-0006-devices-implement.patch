+
+static HRESULT WINAPI device_information_update_GetTrustLevel( IDeviceInformationUpdate *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    *trust_level = BaseTrust;
