+static HRESULT create_from_id_async( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    struct devquery_params *params;
+    IDeviceInformation *info = NULL;
+    const DEV_OBJECT *objects;
+    ULONG len, i;
+    HRESULT hr;
+
+    TRACE( "invoker %p, param %p, result %p, called_async %d\n", invoker, param, result, called_async );
+
+    if (!called_async) return STATUS_PENDING;
+
+    params = impl_from_IUnknown( param );
+    audio_endpoints_sync();
+    if (FAILED(hr = DevGetObjects( params->type, DevQueryFlagNone, params->prop_keys_len, params->prop_keys, 0, NULL, &len, &objects ))) return hr;
+    for (i = 0; i < len; i++)
+    {
+        if (wcsicmp( objects[i].pszObjectId, WindowsGetStringRawBuffer( params->id, NULL ) )) continue;
+        hr = device_information_create( &objects[i], &info );
+        break;
+    }
+    DevFreeObjects( len, objects );
+    if (FAILED(hr)) return hr;
+    if (!info) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+
+    result->vt = VT_UNKNOWN;
+    result->punkVal = (IUnknown *)info;
+    return S_OK;
