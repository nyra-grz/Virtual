+    /* On the desktop a program switched to for itself, i.e. part of a kiosk. */
+    - (BOOL) virtualIsKiosk
+    {
+        return virtual_kiosk_overlay() && virtualDesktop && virtual_kiosk_desktop_active() &&
+               [virtualDesktop caseInsensitiveCompare:virtual_input_desktop] == NSOrderedSame;
+    }
+
+    - (BOOL) virtualKioskDemoted
+    {
+        return virtual_kiosk_shrunk && (fullscreen || virtualKioskShrunk || [self virtualIsKiosk]);
+    }
+
+    - (void) virtualSetDesktop:(NSString*)name
+    {
+        [virtualDesktop release];
+        virtualDesktop = [name copy];
+        [self virtualUpdateDesktop];
+    }
+
+    - (void) virtualUpdateDesktop
+    {
+        BOOL hide = virtualDesktop && virtual_input_desktop &&
+                    [virtualDesktop caseInsensitiveCompare:virtual_input_desktop] != NSOrderedSame;
+
+        if (hide && !virtualDesktopHidden)
+        {
+            virtualDesktopHidden = YES;
+            virtualDesktopWasVisible = [self isVisible];
+            if (virtualDesktopWasVisible) [super orderWindow:NSWindowOut relativeTo:0];
+        }
+        else if (!hide && virtualDesktopHidden)
+        {
+            virtualDesktopHidden = NO;
+            if (virtualDesktopWasVisible) [super orderWindow:NSWindowAbove relativeTo:0];
+            virtualDesktopWasVisible = NO;
+        }
+    }
+
+    /* Wine may order the window in while its desktop is not the input desktop. */
+    - (void) orderWindow:(NSWindowOrderingMode)mode relativeTo:(NSInteger)otherWindowNumber
+    {
+        if (virtualDesktopHidden && mode != NSWindowOut)
+        {
+            virtualDesktopWasVisible = YES;
+            return;
+        }
+        if (virtualDesktopHidden) virtualDesktopWasVisible = NO;
+        [super orderWindow:mode relativeTo:otherWindowNumber];
+    }
+
+    - (void) virtualSetKioskShrunk:(BOOL)shrunk
+    {
+        NSScreen* screen;
+        NSRect frame;
+
+        if (shrunk == virtualKioskShrunk) return;
+        if (shrunk)
+        {
+            if (![self isVisible] || [self isMiniaturized]) return;
+            screen = [self screen] ? [self screen] : [NSScreen mainScreen];
+            if (!fullscreen && !([self virtualIsKiosk] && self.frame.size.width * self.frame.size.height >=
+                                 0.8 * screen.frame.size.width * screen.frame.size.height))
+                return;
+            virtualKioskFrame = self.wine_fractionalFrame;
+            frame = [screen visibleFrame];
+            frame = NSInsetRect(frame, frame.size.width * 0.15, frame.size.height * 0.15);
+        }
+        else
+            frame = virtualKioskFrame;
+
+        virtualKioskShrunk = shrunk;
+        [self setFrameAndWineFrame:frame];
+        [self updateFullscreen];
+        /* The program re-lays itself out for the new size, as after a WM_SIZE on Windows. */
+        [self postWindowFrameChanged:frame fullscreen:NO resizing:NO skipSizeMove:YES];
+    }
