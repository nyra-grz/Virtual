+/* Virtual: a kiosk window (borderless, covering the screen) behaves like an overlay above
+ * normal Mac apps instead of a locked-down full-screen mode, and the user can shrink it to
+ * a normal window with Virtual's shortcut. Set by Virtual for the programs it starts. */
+BOOL virtual_kiosk_overlay(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) enabled = getenv("VIRTUAL_KIOSK_OVERLAY") != NULL;
+    return enabled;
+}
+
+/* Virtual: the input desktop of this prefix, and whether the user shrank the kiosk. */
+static NSString* virtual_input_desktop;
+BOOL virtual_kiosk_shrunk;
+
+void virtual_set_input_desktop(NSString* name)
+{
+    if (!name.length || [name isEqualToString:virtual_input_desktop]) return;
+    [virtual_input_desktop release];
+    virtual_input_desktop = [name copy];
+}
+
+/* A program switched to a desktop of its own (kiosk and exam software does that). */
+static BOOL virtual_kiosk_desktop_active(void)
+{
+    return virtual_input_desktop && [virtual_input_desktop caseInsensitiveCompare:@"Default"] != NSOrderedSame;
+}
