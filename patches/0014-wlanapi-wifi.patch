+static const struct IWiFiNetworkReportVtbl network_report_vtbl =
+{
+    SIMPLE_INSPECTABLE_METHODS( network_report ),
+    network_report_get_Timestamp,
+    network_report_get_AvailableNetworks,
+};
+
+static HRESULT network_report_create( const struct wifi_info_params *info, IWiFiNetworkReport **out )
+{
+    static const struct vector_iids iids =
+    {
+        .iterable = &IID_IIterable_WiFiAvailableNetwork,
+        .iterator = &IID_IIterator_WiFiAvailableNetwork,
+        .vector = &IID_IVector_WiFiAvailableNetwork,
+        .view = &IID_IVectorView_WiFiAvailableNetwork,
+    };
+    struct network_report *impl;
+    IWiFiAvailableNetwork *network;
+    IVector_IInspectable *vector;
+    FILETIME now;
+    HRESULT hr;
+    UINT32 i;
+
+    if (FAILED(hr = vector_inspectable_create( &iids, &vector ))) return hr;
+    for (i = 0; i < info->count && SUCCEEDED(hr); i++)
+    {
+        if (FAILED(hr = available_network_create( &info->networks[i], &network ))) break;
+        hr = IVector_IInspectable_Append( vector, (IInspectable *)network );
+        IWiFiAvailableNetwork_Release( network );
+    }
+    if (FAILED(hr) || !(impl = calloc( 1, sizeof(*impl) )))
+    {
+        IVector_IInspectable_Release( vector );
+        return FAILED(hr) ? hr : E_OUTOFMEMORY;
+    }
+    impl->iface.lpVtbl = &network_report_vtbl;
+    impl->ref = 1;
+    GetSystemTimeAsFileTime( &now );
+    impl->timestamp.UniversalTime = ((INT64)now.dwHighDateTime << 32) | now.dwLowDateTime;
+    hr = IVector_IInspectable_GetView( vector, (IVectorView_IInspectable **)&impl->networks );
+    IVector_IInspectable_Release( vector );
+    if (FAILED(hr))
+    {
+        free( impl );
+        return hr;
+    }
+    *out = &impl->iface;
+    return S_OK;
+}
