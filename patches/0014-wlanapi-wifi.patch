+/* The interface GUID is the one of the IEEE 802.11 network adapter, as on Windows. */
+static BOOL get_interface_guid( GUID *guid )
+{
+    IP_ADAPTER_ADDRESSES *buf = NULL, *aa;
+    ULONG size = 15000, err;
+    BOOL found = FALSE;
+
+    do
+    {
+        free( buf );
+        if (!(buf = malloc( size ))) return FALSE;
+        err = GetAdaptersAddresses( AF_UNSPEC, GAA_FLAG_SKIP_UNICAST | GAA_FLAG_SKIP_ANYCAST |
+                                    GAA_FLAG_SKIP_MULTICAST | GAA_FLAG_SKIP_DNS_SERVER, NULL, buf, &size );
+    } while (err == ERROR_BUFFER_OVERFLOW);
+    for (aa = buf; !err && aa && !found; aa = aa->Next)
+        if (aa->IfType == IF_TYPE_IEEE80211) found = !ConvertInterfaceLuidToGuid( &aa->Luid, guid );
+    free( buf );
+    return found;
+}
+
+static BOOL is_our_interface( const GUID *guid )
+{
+    GUID ours;
+    return guid && get_interface_guid( &ours ) && IsEqualGUID( guid, &ours );
+}
