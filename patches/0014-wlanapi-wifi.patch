+
+static WLAN_SIGNAL_QUALITY signal_quality( INT32 rssi )
+{
+    /* Windows maps -100 dBm to 0 and -50 dBm or better to 100. */
+    if (rssi <= -100) return 0;
+    if (rssi >= -50) return 100;
+    return 2 * (rssi + 100);
+}
+
+static void security_algorithms( INT32 security, BOOL *enabled, DOT11_AUTH_ALGORITHM *auth, DOT11_CIPHER_ALGORITHM *cipher )
+{
+    *enabled = TRUE;
+    switch (security)
+    {
+    case WIFI_SECURITY_OPEN: *enabled = FALSE; *auth = DOT11_AUTH_ALGO_80211_OPEN; *cipher = DOT11_CIPHER_ALGO_NONE; break;
+    case WIFI_SECURITY_WEP: *auth = DOT11_AUTH_ALGO_80211_SHARED_KEY; *cipher = DOT11_CIPHER_ALGO_WEP; break;
+    case WIFI_SECURITY_WPA_PERSONAL: *auth = DOT11_AUTH_ALGO_WPA_PSK; *cipher = DOT11_CIPHER_ALGO_TKIP; break;
+    case WIFI_SECURITY_WPA_ENTERPRISE: *auth = DOT11_AUTH_ALGO_WPA; *cipher = DOT11_CIPHER_ALGO_TKIP; break;
+    case WIFI_SECURITY_WPA2_ENTERPRISE: *auth = DOT11_AUTH_ALGO_RSNA; *cipher = DOT11_CIPHER_ALGO_CCMP; break;
+    case WIFI_SECURITY_WPA3_PERSONAL: *auth = 9 /* DOT11_AUTH_ALGO_WPA3_SAE */; *cipher = DOT11_CIPHER_ALGO_CCMP; break;
+    case WIFI_SECURITY_WPA3_ENTERPRISE: *auth = 10 /* DOT11_AUTH_ALGO_WPA3_ENT */; *cipher = 0x08 /* GCMP_256 */; break;
+    case WIFI_SECURITY_OWE: *auth = 11 /* DOT11_AUTH_ALGO_OWE */; *cipher = DOT11_CIPHER_ALGO_CCMP; break;
+    default: *auth = DOT11_AUTH_ALGO_RSNA_PSK; *cipher = DOT11_CIPHER_ALGO_CCMP; break;
+    }
+}
