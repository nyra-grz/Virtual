@@ -130,6 +130,34 @@ static BOOL get_internet_adapter( struct adapter_info *info )
     return found;
 }
 
+/* The NetworkAdapter of a Wi-Fi interface: the one with the host's interface name,
+ * otherwise the first IEEE 802.11 adapter. */
+HRESULT network_adapter_for_interface( const char *name, INetworkAdapter **out )
+{
+    IP_ADAPTER_ADDRESSES *buf, *aa, *found = NULL;
+    struct adapter_info info, internet;
+    WCHAR nameW[64];
+    HRESULT hr;
+
+    *out = NULL;
+    MultiByteToWideChar( CP_UTF8, 0, name, -1, nameW, ARRAY_SIZE(nameW) );
+    if (!(buf = get_adapters())) return S_OK;
+    for (aa = buf; aa; aa = aa->Next)
+    {
+        if (aa->IfType != IF_TYPE_IEEE80211) continue;
+        if (!found || (aa->FriendlyName && !wcscmp( aa->FriendlyName, nameW ))) found = aa;
+    }
+    if (!found)
+    {
+        free( buf );
+        return S_OK;
+    }
+    fill_adapter_info( found, &info );
+    free( buf );
+    hr = network_adapter_create( &info, get_internet_adapter( &internet ) && internet.if_index == info.if_index, out );
+    return hr;
+}
+
