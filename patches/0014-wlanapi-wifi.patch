+};
+
+static HRESULT async_operation_create( const struct IAsyncOperation_IInspectableVtbl *vtbl, const GUID *iid, IUnknown *invoker,
+                                       IUnknown *param, async_operation_callback callback, IAsyncOperation_IInspectable **out );
+
+HRESULT async_operation_int32_create( const GUID *iid, IUnknown *invoker, IUnknown *param, async_operation_callback callback,
+                                      IAsyncOperation_IInspectable **out )
+{
+    return async_operation_create( &async_int32_vtbl, iid, invoker, param, callback, out );
+}
+
 HRESULT async_operation_inspectable_create( const GUID *iid, IUnknown *invoker, IUnknown *param, async_operation_callback callback,
                                             IAsyncOperation_IInspectable **out )
+{
+    return async_operation_create( &async_inspectable_vtbl, iid, invoker, param, callback, out );
+}
+
+static HRESULT async_operation_create( const struct IAsyncOperation_IInspectableVtbl *vtbl, const GUID *iid, IUnknown *invoker,
+                                       IUnknown *param, async_operation_callback callback, IAsyncOperation_IInspectable **out )
 {
     struct async_inspectable *impl;
     HRESULT hr;
 
     *out = NULL;
     if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
-    impl->IAsyncOperation_IInspectable_iface.lpVtbl = &async_inspectable_vtbl;
