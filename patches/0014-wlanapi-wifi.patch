+/* WiFiAdapter */
+
+struct event_handler
+{
+    struct list entry;
+    EventRegistrationToken token;
+    ITypedEventHandler_WiFiAdapter_IInspectable *handler;
+};
+
+struct wifi_adapter
+{
+    IWiFiAdapter iface;
+    LONG ref;
+    CRITICAL_SECTION cs;
+    struct wifi_info_params *last_scan;
+    struct list handlers;
+    INT64 next_token;
+};
+
+DEFINE_SIMPLE_INSPECTABLE( wifi_adapter, IWiFiAdapter, struct wifi_adapter, L"Windows.Devices.WiFi.WiFiAdapter" )
+
+static void wifi_adapter_destroy( struct wifi_adapter *impl )
+{
+    struct event_handler *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( entry, next, &impl->handlers, struct event_handler, entry )
+    {
+        ITypedEventHandler_WiFiAdapter_IInspectable_Release( entry->handler );
+        free( entry );
+    }
+    free( impl->last_scan );
+    impl->cs.DebugInfo->Spare[0] = 0;
+    DeleteCriticalSection( &impl->cs );
+    free( impl );
+}
+
+static HRESULT WINAPI wifi_adapter_get_NetworkAdapter( IWiFiAdapter *iface, INetworkAdapter **value )
+{
+    struct wifi_info_params *info;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    if (FAILED(hr = query_wifi( FALSE, &info ))) return hr;
+    hr = network_adapter_for_interface( info->name, value );
+    free( info );
+    return hr;
+}
+
+static HRESULT scan_callback( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    struct wifi_adapter *impl = wifi_adapter_from_iface( (IWiFiAdapter *)invoker );
+    ITypedEventHandler_WiFiAdapter_IInspectable **handlers = NULL;
+    struct wifi_info_params *info;
+    struct event_handler *entry;
+    UINT32 count = 0, i;
+    HRESULT hr;
+
+    if (!called_async) return STATUS_PENDING;
+    if (FAILED(hr = query_wifi( TRUE, &info ))) return hr;
+
+    EnterCriticalSection( &impl->cs );
+    free( impl->last_scan );
+    impl->last_scan = info;
+    if ((handlers = calloc( list_count( &impl->handlers ) + 1, sizeof(*handlers) )))
+        LIST_FOR_EACH_ENTRY( entry, &impl->handlers, struct event_handler, entry )
+            ITypedEventHandler_WiFiAdapter_IInspectable_AddRef( (handlers[count++] = entry->handler) );
+    LeaveCriticalSection( &impl->cs );
+
+    /* Outside the lock: a handler may read the new NetworkReport. */
+    for (i = 0; i < count; i++)
+    {
+        ITypedEventHandler_WiFiAdapter_IInspectable_Invoke( handlers[i], &impl->iface, NULL );
+        ITypedEventHandler_WiFiAdapter_IInspectable_Release( handlers[i] );
+    }
+    free( handlers );
+    return S_OK;
+}
+
+static HRESULT WINAPI wifi_adapter_ScanAsync( IWiFiAdapter *iface, IAsyncAction **operation )
+{
+    TRACE( "iface %p, operation %p.\n", iface, operation );
+    if (!operation) return E_POINTER;
+    return async_action_create( (IUnknown *)iface, scan_callback, operation );
+}
+
+static HRESULT WINAPI wifi_adapter_get_NetworkReport( IWiFiAdapter *iface, IWiFiNetworkReport **value )
+{
+    struct wifi_adapter *impl = wifi_adapter_from_iface( iface );
+    struct wifi_info_params *info;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+
+    /* Without a ScanAsync call, report what the host has seen most recently. */
+    EnterCriticalSection( &impl->cs );
+    hr = impl->last_scan ? network_report_create( impl->last_scan, value ) : S_FALSE;
+    LeaveCriticalSection( &impl->cs );
+    if (hr != S_FALSE) return hr;
+
+    if (FAILED(hr = query_wifi( FALSE, &info ))) return hr;
+    hr = network_report_create( info, value );
+    free( info );
+    return hr;
+}
+
+static HRESULT WINAPI wifi_adapter_add_AvailableNetworksChanged( IWiFiAdapter *iface, ITypedEventHandler_WiFiAdapter_IInspectable *handler,
+                                                                 EventRegistrationToken *token )
+{
+    struct wifi_adapter *impl = wifi_adapter_from_iface( iface );
+    struct event_handler *entry;
+
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+    if (!handler || !token) return E_POINTER;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    ITypedEventHandler_WiFiAdapter_IInspectable_AddRef( (entry->handler = handler) );
+    EnterCriticalSection( &impl->cs );
+    entry->token.value = ++impl->next_token;
+    list_add_tail( &impl->handlers, &entry->entry );
+    LeaveCriticalSection( &impl->cs );
+    *token = entry->token;
+    return S_OK;
+}
+
+static HRESULT WINAPI wifi_adapter_remove_AvailableNetworksChanged( IWiFiAdapter *iface, EventRegistrationToken token )
+{
+    struct wifi_adapter *impl = wifi_adapter_from_iface( iface );
+    struct event_handler *entry, *found = NULL;
+
+    TRACE( "iface %p, token %#I64x.\n", iface, token.value );
+    EnterCriticalSection( &impl->cs );
+    LIST_FOR_EACH_ENTRY( entry, &impl->handlers, struct event_handler, entry )
+    {
+        if (entry->token.value != token.value) continue;
+        list_remove( &entry->entry );
+        found = entry;
+        break;
+    }
+    LeaveCriticalSection( &impl->cs );
+    if (found)
+    {
+        ITypedEventHandler_WiFiAdapter_IInspectable_Release( found->handler );
+        free( found );
+    }
+    return S_OK;
+}
+
+static HRESULT connect_callback( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    IWiFiAvailableNetwork *network = (IWiFiAvailableNetwork *)param;
+    IWiFiConnectionResult *connection;
+    WiFiConnectionStatus status;
+    HRESULT hr;
+
+    /* Joining networks belongs to macOS; a Windows program is only told it is connected
+     * to the network the Mac already uses. */
+    if (network && network->lpVtbl == &available_network_vtbl && available_network_from_iface( network )->net.current)
+        status = WiFiConnectionStatus_Success;
+    else
+        status = WiFiConnectionStatus_AccessRevoked;
+    if (FAILED(hr = connection_result_create( status, &connection ))) return hr;
+    result->vt = VT_UNKNOWN;
+    result->punkVal = (IUnknown *)connection;
+    return S_OK;
+}
+
+static HRESULT connect_async( IWiFiAdapter *iface, IWiFiAvailableNetwork *network, IAsyncOperation_WiFiConnectionResult **operation )
+{
+    if (!network || !operation) return E_POINTER;
+    return async_operation_inspectable_create( &IID_IAsyncOperation_WiFiConnectionResult, (IUnknown *)iface, (IUnknown *)network,
+                                               connect_callback, (IAsyncOperation_IInspectable **)operation );
+}
+
+static HRESULT WINAPI wifi_adapter_ConnectAsync( IWiFiAdapter *iface, IWiFiAvailableNetwork *network, WiFiReconnectionKind kind,
+                                                 IAsyncOperation_WiFiConnectionResult **operation )
+{
+    TRACE( "iface %p, network %p, kind %d, operation %p.\n", iface, network, kind, operation );
+    return connect_async( iface, network, operation );
+}
