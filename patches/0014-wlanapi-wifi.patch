+    if (!handle || !guid || reserved || !data_size || !data) return ERROR_INVALID_PARAMETER;
+    if (!handle_index(handle)) return ERROR_INVALID_HANDLE;
+    if (!is_our_interface(guid)) return ERROR_NOT_FOUND;
+    if (!(info = query_host(FALSE))) return ERROR_NOT_ENOUGH_MEMORY;
+
+    switch (opcode)
+    {
+    case wlan_intf_opcode_interface_state:
+        value = !info->power_on ? wlan_interface_state_not_ready :
+                info->associated ? wlan_interface_state_connected : wlan_interface_state_disconnected;
+        break;
+    case wlan_intf_opcode_channel_number:
+        if (!info->associated) ret = ERROR_INVALID_STATE;
+        value = info->networks[0].channel;
+        break;
+    case wlan_intf_opcode_rssi:
+        if (!info->associated) ret = ERROR_INVALID_STATE;
+        value = info->networks[0].rssi;
+        break;
+    case wlan_intf_opcode_bss_type:
+        value = dot11_BSS_type_infrastructure;
+        break;
+    case wlan_intf_opcode_current_connection:
+    {
+        const struct wifi_network *net = &info->networks[0];
+        WLAN_CONNECTION_ATTRIBUTES *attr;
+        size_t len = strlen(net->ssid);
+
+        if (!info->associated)
+        {
+            ret = ERROR_INVALID_STATE;
+            break;
+        }
+        if (!(attr = WlanAllocateMemory(sizeof(*attr))))
+        {
+            ret = ERROR_NOT_ENOUGH_MEMORY;
+            break;
+        }
+        memset(attr, 0, sizeof(*attr));
+        attr->isState = wlan_interface_state_connected;
+        attr->wlanConnectionMode = wlan_connection_mode_profile;
+        /* Windows names the profile after the SSID; macOS hides it without location access. */
+        MultiByteToWideChar(CP_UTF8, 0, net->ssid, -1, attr->strProfileName, ARRAY_SIZE(attr->strProfileName));
+        attr->wlanAssociationAttributes.dot11Ssid.uSSIDLength = len;
+        memcpy(attr->wlanAssociationAttributes.dot11Ssid.ucSSID, net->ssid, len);
+        attr->wlanAssociationAttributes.dot11BssType = net->adhoc ? dot11_BSS_type_independent : dot11_BSS_type_infrastructure;
+        if (net->has_bssid) memcpy(attr->wlanAssociationAttributes.dot11Bssid, net->bssid, sizeof(net->bssid));
+        attr->wlanAssociationAttributes.dot11PhyType = phy_type(net->phy);
+        attr->wlanAssociationAttributes.wlanSignalQuality = signal_quality(net->rssi);
+        security_algorithms(net->security, &attr->wlanSecurityAttributes.bSecurityEnabled,
+                            &attr->wlanSecurityAttributes.dot11AuthAlgorithm,
+                            &attr->wlanSecurityAttributes.dot11CipherAlgorithm);
+        attr->wlanSecurityAttributes.bOneXEnabled = net->security == WIFI_SECURITY_WPA_ENTERPRISE ||
+                                                    net->security == WIFI_SECURITY_WPA2_ENTERPRISE ||
+                                                    net->security == WIFI_SECURITY_WPA3_ENTERPRISE;
+        free(info);
+        *data = attr;
+        *data_size = sizeof(*attr);
+        if (opcode_type) *opcode_type = wlan_opcode_value_type_query_only;
+        return ERROR_SUCCESS;
+    }
+    default:
+        FIXME("opcode 0x%x not supported\n", opcode);
+        ret = ERROR_NOT_SUPPORTED;
+        break;
+    }
+    free(info);
+    if (ret) return ret;
+
+    if (!(*data = WlanAllocateMemory(sizeof(DWORD)))) return ERROR_NOT_ENOUGH_MEMORY;
+    *(DWORD *)*data = value;
+    *data_size = sizeof(DWORD);
+    if (opcode_type) *opcode_type = wlan_opcode_value_type_query_only;
+    return ERROR_SUCCESS;
 }
 
