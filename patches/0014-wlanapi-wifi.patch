new file mode 100644
index 0000000..c0b5389
--- /dev/null
+++ b/dlls/windows.devices.enumeration/network.c
@@ -0,0 +1,87 @@
+/* Audio endpoints as device interfaces
+ *
+ * Copyright (C) 2026 Daniel Özdek
+ *
