+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+#include "setupapi.h"
+#include "devpkey.h"
+#include "wine/wifi.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(enumeration);
+
+static const GUID network_class = {0x4d36e972, 0xe325, 0x11ce, {0xbf, 0xc1, 0x08, 0x00, 0x2b, 0xe1, 0x03, 0x18}};
+static const GUID network_interface = {0xcac88484, 0x7515, 0x4c03, {0x82, 0xe6, 0x71, 0xa8, 0x7a, 0xba, 0xc3, 0x61}};
+static SRWLOCK network_lock = SRWLOCK_INIT;
+
+/* Publish the same real host interface that WiFiAdapter.FindAllAdaptersAsync returns.
+ * SetupAPI generates its symbolic link from VIRTUAL\\WIFI\\<MAC>, matching FromIdAsync.
+ * Do not invent an interface when the host has none. */
+void network_interfaces_sync( void )
+{
+    SP_DEVICE_INTERFACE_DATA iface = {.cbSize = sizeof(iface)};
+    SP_DEVINFO_DATA dev = {.cbSize = sizeof(dev)};
+    struct wifi_info_params *info;
+    wine_wlan_query_func query;
+    WCHAR instance[128], name[64], old_instance[256];
+    HMODULE module;
+    HDEVINFO set;
+    DWORD index;
+
+    if (!(module = LoadLibraryW( L"wlanapi.dll" ))) return;
+    query = (wine_wlan_query_func)GetProcAddress( module, "__wine_wlan_query" );
+    if (!(info = calloc( 1, sizeof(*info) ))) goto done;
+    if (!query || query( info, FALSE )) goto free_info;
+
+    AcquireSRWLockExclusive( &network_lock );
+    if ((set = SetupDiGetClassDevsW( &network_interface, NULL, NULL, DIGCF_DEVICEINTERFACE )) == INVALID_HANDLE_VALUE)
+        goto unlock;
+    /* Previous adapters may have disappeared or changed. Mark only our devices inactive. */
+    for (index = 0; SetupDiEnumDeviceInterfaces( set, NULL, &network_interface, index, &iface ); index++)
+    {
+        if (SetupDiGetDeviceInterfaceDetailW( set, &iface, NULL, 0, NULL, &dev ) || GetLastError() == ERROR_INSUFFICIENT_BUFFER)
+            if (SetupDiGetDeviceInstanceIdW( set, &dev, old_instance, ARRAY_SIZE(old_instance), NULL ) &&
+                !wcsnicmp( old_instance, L"VIRTUAL\\WIFI\\", 13 ))
+                device_interface_set_linked( set, &iface, FALSE );
+    }
+    if (!info->present) goto destroy;
+
+    swprintf( instance, ARRAY_SIZE(instance), L"VIRTUAL\\WIFI\\%02X%02X%02X%02X%02X%02X",
+              info->mac[0], info->mac[1], info->mac[2], info->mac[3], info->mac[4], info->mac[5] );
+    if (!SetupDiOpenDeviceInfoW( set, instance, NULL, 0, &dev ) &&
+        (!SetupDiCreateDeviceInfoW( set, instance, &network_class, NULL, NULL, 0, &dev ) ||
+         !SetupDiRegisterDeviceInfo( set, &dev, 0, NULL, NULL, NULL ))) goto destroy;
+    if (!SetupDiCreateDeviceInterfaceW( set, &dev, &network_interface, NULL, 0, &iface )) goto destroy;
+    swprintf( name, ARRAY_SIZE(name), L"Wi-Fi (%hs)", info->name );
+    SetupDiSetDevicePropertyW( set, &dev, &DEVPKEY_Device_FriendlyName, DEVPROP_TYPE_STRING,
+                               (BYTE *)name, (wcslen(name) + 1) * sizeof(WCHAR), 0 );
+    SetupDiSetDeviceInterfacePropertyW( set, &iface, &DEVPKEY_DeviceInterface_FriendlyName, DEVPROP_TYPE_STRING,
+                                        (BYTE *)name, (wcslen(name) + 1) * sizeof(WCHAR), 0 );
+    /* Radio power and interface availability are separate; an off radio still has an adapter. */
+    device_interface_set_linked( set, &iface, TRUE );
+    TRACE( "registered host Wi-Fi interface %s.\n", debugstr_w(instance) );
+
+destroy:
+    SetupDiDestroyDeviceInfoList( set );
+unlock:
+    ReleaseSRWLockExclusive( &network_lock );
+free_info:
+    free( info );
+done:
+    FreeLibrary( module );
+}
