+static HRESULT WINAPI available_network_get_ChannelCenterFrequencyInKilohertz( IWiFiAvailableNetwork *iface, INT32 *value )
+{
+    struct available_network *impl = available_network_from_iface( iface );
+    INT32 channel = impl->net.channel;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    switch (impl->net.band)
+    {
+    case 1: *value = (channel == 14 ? 2484 : 2407 + 5 * channel) * 1000; break;
+    case 2: *value = (5000 + 5 * channel) * 1000; break;
+    case 3: *value = (5950 + 5 * channel) * 1000; break;
+    default: *value = 0; break;
+    }
+    return S_OK;
+}
