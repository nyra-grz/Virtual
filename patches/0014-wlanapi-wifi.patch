+static const IUnknownVtbl hstring_param_vtbl = { hstring_param_QueryInterface, hstring_param_AddRef, hstring_param_Release };
+
+static HRESULT from_id_param_callback( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    return from_id_callback( invoker, (IUnknown *)CONTAINING_RECORD( param, struct hstring_param, IUnknown_iface )->value,
+                             result, called_async );
