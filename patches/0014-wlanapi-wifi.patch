+static HRESULT WINAPI async_int32_GetResults( IAsyncOperation_IInspectable *iface, IInspectable **results )
+{
+    struct async_inspectable *impl = impl_from_IAsyncOperation_IInspectable( iface );
+    INT32 *value = (INT32 *)results;
+    PROPVARIANT result;
+    HRESULT hr;
+
+    TRACE( "iface %p, results %p.\n", iface, results );
+
+    PropVariantInit( &result );
+    if (SUCCEEDED(hr = IAsyncInfoImpl_get_Result( impl->IAsyncInfoImpl_inner, &result )))
+    {
+        *value = result.lVal;
+        PropVariantClear( &result );
+    }
+
+    return hr;
+}
+
+/* Same layout as IAsyncOperation<IInspectable *>, only GetResults returns an INT32. */
