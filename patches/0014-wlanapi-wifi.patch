+    TRACE( "iface %p, id %s, operation %p.\n", iface, debugstr_hstring( id ), operation );
+    if (!operation) return E_POINTER;
+    if (!(param = calloc( 1, sizeof(*param) ))) return E_OUTOFMEMORY;
+    param->IUnknown_iface.lpVtbl = &hstring_param_vtbl;
+    param->ref = 1;
