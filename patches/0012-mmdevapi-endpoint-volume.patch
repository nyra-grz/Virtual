+/* Applies a change under the writer lock; S_FALSE if nothing changed. */
+static HRESULT change_volume(AEVImpl *This, enum volume_change change, UINT chan, float value, const GUID *ctx)
+{
+    struct endpoint_volume_state *state = This->state;
+    struct endpoint_volume_values values;
+    BOOL changed;
+    float delta;
+    UINT i;
+
+    while (InterlockedCompareExchange(&state->lock, 1, 0))
+        YieldProcessor();
+
+    values = state->values;
+    switch (change) {
+    case CHANGE_MASTER:
+        /* Moves all channels together, so the balance stays as it was. */
+        delta = value - master_level(&values);
+        for (i = 0; i < values.channels; i++)
+            values.levels[i] = min(max(values.levels[i] + delta, VOLUME_MIN_DB), VOLUME_MAX_DB);
+        break;
+    case CHANGE_CHANNEL:
+        values.levels[chan] = value;
+        break;
+    case CHANGE_MUTE:
+        values.mute = value != 0.0f;
+        break;
+    }
+
+    changed = memcmp(&values, &state->values, offsetof(struct endpoint_volume_values, context)) != 0;
+    if (changed) {
+        if (ctx)
+            values.context = *ctx;
+        else
+            memset(&values.context, 0, sizeof(values.context));
+        InterlockedIncrement(&state->version);
+        state->values = values;
+        InterlockedIncrement(&state->version);
+    }
+    InterlockedExchange(&state->lock, 0);
+
+    if (!changed)
+        return S_FALSE;
+    save_values(&This->guid, &values);
+    return S_OK;
+}
+
+static void dispatch_notification(struct volume_notify *notify)
+{
+    struct endpoint_volume_values values;
+    AUDIO_VOLUME_NOTIFICATION_DATA *data;
+    UINT i;
+
+    notify->version = read_values(notify->state, &values);
+    if (!(data = malloc(offsetof(AUDIO_VOLUME_NOTIFICATION_DATA, afChannelVolumes[values.channels]))))
+        return;
+    data->guidEventContext = values.context;
+    data->bMuted = values.mute;
+    data->fMasterVolume = db_to_scalar(master_level(&values));
+    data->nChannels = values.channels;
+    for (i = 0; i < values.channels; i++)
+        data->afChannelVolumes[i] = db_to_scalar(values.levels[i]);
+    IAudioEndpointVolumeCallback_OnNotify(notify->callback, data);
+    free(data);
+}
+
+/* Like on Windows, callbacks arrive on their own thread, also for changes
+ * made by other processes of the prefix. */
+static DWORD WINAPI notify_proc(void *arg)
+{
+    HMODULE module = arg;
+    struct volume_notify *notify;
+    BOOL dispatched;
+
+    SetThreadDescription(GetCurrentThread(), L"wine_mmdevapi_volume_notify");
+    for (;;) {
+        Sleep(20);
+        EnterCriticalSection(&notify_cs);
+        if (list_empty(&notifications)) {
+            CloseHandle(notify_thread);
+            notify_thread = NULL;
+            LeaveCriticalSection(&notify_cs);
+            break;
+        }
+        /* A callback may unregister, so start over after each one. */
+        do {
+            dispatched = FALSE;
+            LIST_FOR_EACH_ENTRY(notify, &notifications, struct volume_notify, entry) {
+                if (endpoint_volume_version(notify->state) != notify->version) {
+                    dispatch_notification(notify);
+                    dispatched = TRUE;
+                    break;
+                }
+            }
+        } while (dispatched);
+        LeaveCriticalSection(&notify_cs);
+    }
+    FreeLibraryAndExitThread(module, 0);
+}
