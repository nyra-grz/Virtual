+static const WCHAR volume_keyW[] = L"Software\\Wine\\MMDevAPI\\EndpointVolume";
+
+static float db_to_scalar(float db)
+{
+    return db <= VOLUME_MIN_DB ? 0.0f : powf(10.0f, db / 20.0f);
+}
+
+static float scalar_to_db(float scalar)
+{
+    return scalar <= 0.0f ? VOLUME_MIN_DB : max(VOLUME_MIN_DB, 20.0f * log10f(scalar));
+}
+
+static float master_level(const struct endpoint_volume_values *values)
+{
+    float level = VOLUME_MIN_DB;
+    UINT i;
+
+    for (i = 0; i < values->channels; i++)
+        level = max(level, values->levels[i]);
+    return level;
+}
+
+static UINT device_channel_count(const GUID *guid, IMMDevice *device)
+{
+    IAudioClient *client;
+    WAVEFORMATEX *fmt;
+    UINT channels = 2;
+
+    if (SUCCEEDED(AudioClient_Create((GUID *)guid, device, &client))) {
+        if (SUCCEEDED(IAudioClient_GetMixFormat(client, &fmt))) {
+            channels = fmt->nChannels;
+            CoTaskMemFree(fmt);
+        }
+        IAudioClient_Release(client);
+    }
+    return min(max(channels, 1), MAX_ENDPOINT_CHANNELS);
+}
+
+struct saved_volume {
+    UINT channels;
+    BOOL mute;
+    float levels[MAX_ENDPOINT_CHANNELS];
+};
+
+static void load_values(const GUID *guid, struct endpoint_volume_values *values)
+{
+    struct saved_volume saved;
+    DWORD size = sizeof(saved), type;
+    WCHAR name[39];
+    HKEY key;
+    UINT i;
+
+    StringFromGUID2(guid, name, ARRAY_SIZE(name));
+    if (RegOpenKeyExW(HKEY_CURRENT_USER, volume_keyW, 0, KEY_READ, &key))
+        return;
+    if (!RegQueryValueExW(key, name, NULL, &type, (BYTE *)&saved, &size) && type == REG_BINARY &&
+        size >= offsetof(struct saved_volume, levels) && saved.channels == values->channels &&
+        size == offsetof(struct saved_volume, levels[saved.channels])) {
+        values->mute = !!saved.mute;
+        for (i = 0; i < saved.channels; i++)
+            values->levels[i] = min(max(saved.levels[i], VOLUME_MIN_DB), VOLUME_MAX_DB);
+    }
+    RegCloseKey(key);
+}
+
+static void save_values(const GUID *guid, const struct endpoint_volume_values *values)
+{
+    struct saved_volume saved;
+    WCHAR name[39];
+    HKEY key;
+
+    saved.channels = values->channels;
+    saved.mute = values->mute;
+    memcpy(saved.levels, values->levels, values->channels * sizeof(float));
+    StringFromGUID2(guid, name, ARRAY_SIZE(name));
+    if (RegCreateKeyExW(HKEY_CURRENT_USER, volume_keyW, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL))
+        return;
+    RegSetValueExW(key, name, 0, REG_BINARY, (BYTE *)&saved, offsetof(struct saved_volume, levels[saved.channels]));
+    RegCloseKey(key);
+}
