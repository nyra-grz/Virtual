+/* CoreAudio has no per-stream volume and the device volume belongs to the
+ * Mac, so session, stream and endpoint volumes are applied to the samples. */
+static void adjust_buffer_volume(struct coreaudio_stream *stream, BYTE *buf, UINT32 frames)
+{
+    const WAVEFORMATEXTENSIBLE *fmtex = (const WAVEFORMATEXTENSIBLE *)stream->fmt;
+    const UINT32 channels = stream->fmt->nChannels, align = stream->fmt->nBlockAlign;
+    BYTE *frame, *end = buf + frames * align;
+    BOOL adjust = FALSE, mute = TRUE, is_float;
+    UINT32 i;
+
+    if(!stream->vols || !frames)
+        return;
+    for(i = 0; i < channels; i++){
+        adjust |= stream->vols[i] != 1.0f;
+        mute &= stream->vols[i] == 0.0f;
+    }
+    if(!adjust)
+        return;
+    if(mute){
+        silence_buffer(stream, buf, frames);
+        return;
+    }
+
+    is_float = stream->fmt->wFormatTag == WAVE_FORMAT_IEEE_FLOAT ||
+               (stream->fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE &&
+                IsEqualGUID(&fmtex->SubFormat, &KSDATAFORMAT_SUBTYPE_IEEE_FLOAT));
+
+#define PROCESS_BUFFER(type) \
+    for(frame = buf; frame < end; frame += align) \
+        for(i = 0; i < channels; i++) \
+            ((type *)frame)[i] = ((type *)frame)[i] * (double)stream->vols[i]
+
+    if(is_float){
+        if(stream->fmt->wBitsPerSample == 32) PROCESS_BUFFER(float);
+        else if(stream->fmt->wBitsPerSample == 64) PROCESS_BUFFER(double);
+        return;
+    }
+
+    switch(stream->fmt->wBitsPerSample){
+    case 8:
+        for(frame = buf; frame < end; frame += align)
+            for(i = 0; i < channels; i++)
+                frame[i] = (int)((frame[i] - 128) * stream->vols[i]) + 128;
+        break;
+    case 16:
+        PROCESS_BUFFER(INT16);
+        break;
+    case 24:
+        for(frame = buf; frame < end; frame += align)
+            for(i = 0; i < channels; i++){
+                BYTE *p = frame + i * 3;
+                INT32 v = (INT32)((UINT32)p[0] << 8 | (UINT32)p[1] << 16 | (UINT32)p[2] << 24);
+                v = v * (double)stream->vols[i];
+                p[0] = v >> 8;
+                p[1] = v >> 16;
+                p[2] = v >> 24;
+            }
+        break;
+    case 32:
+        PROCESS_BUFFER(INT32);
+        break;
+    }
+#undef PROCESS_BUFFER
+}
