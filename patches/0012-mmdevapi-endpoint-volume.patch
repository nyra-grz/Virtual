+/* Lives in a named section, so like on Windows every process of the prefix
+ * sees and changes the same endpoint volume. */
+struct endpoint_volume_state {
+    LONG init;    /* 0 = new, 1 = initializing, 2 = ready */
+    LONG lock;    /* held by a writer */
+    LONG version; /* odd while a write is in progress */
