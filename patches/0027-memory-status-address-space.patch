--- a/dlls/kernelbase/memory.c
+++ b/dlls/kernelbase/memory.c
@@ -1396,16 +1396,44 @@
 }
 
 
+/* Available virtual address space is unrelated to resident physical pages.
+ * Count actual free Windows regions, including reservations made since the
+ * physical-memory status cache was refreshed. */
+static NTSTATUS query_available_virtual_memory( const SYSTEM_BASIC_INFORMATION *basic_info, ULONGLONG *available )
+{
+    ULONG_PTR address = (ULONG_PTR)basic_info->LowestUserAddress;
+    ULONG_PTR limit = (ULONG_PTR)basic_info->HighestUserAddress + 1;
+    MEMORY_BASIC_INFORMATION info;
+    ULONGLONG free_size = 0;
+    NTSTATUS status;
+
+    while (address < limit)
+    {
+        ULONG_PTR base;
+        SIZE_T size;
+        status = NtQueryVirtualMemory( GetCurrentProcess(), (void *)address, MemoryBasicInformation,
+                                       &info, sizeof(info), NULL );
+        if (status) return status;
+        base = (ULONG_PTR)info.BaseAddress;
+        if (base > address || info.RegionSize <= address - base) return STATUS_INVALID_ADDRESS;
+        size = min( info.RegionSize - (address - base), limit - address );
+        if (info.State == MEM_FREE) free_size += size;
+        address += size;
+    }
+    *available = free_size;
+    return STATUS_SUCCESS;
+}
+
